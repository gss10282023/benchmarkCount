{
  "domain_machine_constraints": {
    "agentdojo": [
      "other_vps"
    ],
    "appworld": [
      "other_vps"
    ],
    "tau3_retail": [
      "other_vps"
    ],
    "webarena_verified": [
      "webarena_vps"
    ]
  },
  "dry_run": false,
  "machines": [
    {
      "allowed_domains": [
        "agentdojo",
        "appworld",
        "tau3_retail"
      ],
      "benchmarks": {
        "agentdojo": {
          "runner_command": "agentdojo-runner"
        },
        "appworld": {
          "runner_command": "appworld"
        },
        "tau3_retail": {
          "runner_command": "tau3-retail"
        }
      },
      "connection": "ssh",
      "machine_id": "other-vps-001",
      "role": "other_vps"
    },
    {
      "allowed_domains": [
        "webarena_verified"
      ],
      "benchmarks": {
        "webarena_verified": {
          "runner_command": "webarena-verified"
        }
      },
      "connection": "ssh",
      "machine_id": "webarena-vps-001",
      "role": "webarena_vps"
    }
  ],
  "paths": {
    "logs_dir": "results/logs",
    "results_root": "results"
  },
  "rsync": {
    "exclude": []
  },
  "schema_version": "infra/v1"
}
