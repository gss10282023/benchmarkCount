{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_credential_probe_receipt.schema.json",
  "title": "agentdojo_openrouter_credential_probe_receipt",
  "description": "Fail-closed, content-free receipt proving OpenRouter credentials, credit floor, model availability, runtime policy, and runtime infrastructure before AgentDojo execution.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agentdojo_openrouter_credential_probe_receipt/v1"
    },
    "status": {
      "const": "passed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "probe_phase": {
      "enum": ["pre_ramp", "post_ramp"]
    },
    "http_status": {
      "const": 200
    },
    "secret_material_recorded": {
      "const": false
    },
    "response_body_recorded": {
      "const": false
    },
    "runtime_policy_semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_infra_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "credit_remaining_usd": {
      "type": "number",
      "minimum": 650.0
    },
    "credit_floor_usd": {
      "const": 650.0
    },
    "key_is_free_tier": {
      "const": false
    },
    "key_limit_reset_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "key_expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deprecated_rate_limit_used": {
      "const": false
    },
    "models_available": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "openai/gpt-5.4",
          "anthropic/claude-opus-4.7",
          "deepseek/deepseek-v4-pro"
        ]
      }
    },
    "model_catalog": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "enum": [
              "openai/gpt-5.4",
              "anthropic/claude-opus-4.7",
              "deepseek/deepseek-v4-pro"
            ]
          },
          "context_length": {
            "type": "integer",
            "minimum": 1
          },
          "pricing": {
            "type": "object",
            "minProperties": 4,
            "propertyNames": {"pattern": "^[a-z0-9_]{1,64}$"},
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "required": ["prompt", "completion", "request", "internal_reasoning"]
          },
          "pricing_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["model_id", "context_length", "pricing", "pricing_sha256"]
      }
    },
    "model_catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "created_at",
    "probe_phase",
    "http_status",
    "secret_material_recorded",
    "response_body_recorded",
    "runtime_policy_semantic_sha256",
    "runtime_infra_file_sha256",
    "credit_remaining_usd",
    "credit_floor_usd",
    "key_is_free_tier",
    "key_limit_reset_at",
    "key_expires_at",
    "deprecated_rate_limit_used",
    "models_available",
    "model_catalog",
    "model_catalog_sha256"
  ]
}
