{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/failure_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "collect_results_manifest_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "command_hash": {
      "$ref": "#/$defs/sha256"
    },
    "deployment_manifest_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "failed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "failure_category": {
      "enum": [
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "agent_caused",
        "schema_validation",
        "deployment",
        "collection",
        "resume",
        "unknown"
      ],
      "type": "string"
    },
    "failure_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "final_attempt": {
      "type": "boolean"
    },
    "machine_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "command_hash": {
          "$ref": "#/$defs/sha256"
        },
        "config_hash": {
          "$ref": "#/$defs/sha256"
        },
        "environment_hash": {
          "$ref": "#/$defs/sha256"
        },
        "failure_linkage": {
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "deployment_manifest_path": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "failure_record_id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "record_slot_id": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "failure_record_id",
            "record_slot_id",
            "attempt_id",
            "deployment_manifest_path"
          ],
          "type": "object"
        },
        "machine_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_path": {
          "$ref": "#/$defs/path"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_stage": {
          "enum": [
            "check_infra",
            "deploy_all",
            "deploy_webarena",
            "deploy_osworld",
            "deploy_other_vps",
            "deploy_local_androidworld",
            "monitor",
            "collect_results",
            "resume_failed",
            "adapter_run",
            "scoring",
            "aggregation",
            "paper_output",
            "final_report",
            "release"
          ],
          "type": "string"
        }
      },
      "required": [
        "command_hash",
        "config_hash",
        "manifest_hash",
        "environment_hash",
        "machine_id",
        "workflow_stage",
        "source_path",
        "source_sha256",
        "failure_linkage"
      ],
      "type": "object"
    },
    "raw_log_path": {
      "$ref": "#/$defs/path"
    },
    "record_slot_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "recoverable": {
      "type": "boolean"
    },
    "resume_manifest_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "retry_count": {
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "failure_record/v1"
    },
    "workflow_stage": {
      "enum": [
        "check_infra",
        "deploy_all",
        "deploy_webarena",
        "deploy_osworld",
        "deploy_other_vps",
        "deploy_local_androidworld",
        "monitor",
        "collect_results",
        "resume_failed",
        "adapter_run",
        "scoring",
        "aggregation",
        "paper_output",
        "final_report",
        "release"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "failure_id",
    "final_attempt",
    "phase",
    "experiment_type",
    "priority",
    "workflow_stage",
    "failure_category",
    "recoverable",
    "retry_count",
    "failed_at",
    "command_hash",
    "raw_log_path",
    "provenance"
  ],
  "title": "failure_record",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
