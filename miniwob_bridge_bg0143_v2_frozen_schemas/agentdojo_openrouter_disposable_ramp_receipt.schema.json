{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_disposable_ramp_receipt.schema.json",
  "title": "agentdojo_openrouter_disposable_ramp_receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "per_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "request_count": {"type": "integer", "minimum": 4},
        "success_count": {"type": "integer", "minimum": 4}
      },
      "required": ["model_config_sha256", "request_count", "success_count"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_disposable_ramp_receipt/v1"},
    "status": {"const": "passed"},
    "created_at": {"type": "string", "format": "date-time"},
    "stages": {
      "type": "array",
      "prefixItems": [{"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "stage_receipts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "worker_concurrency": {"enum": [4, 8, 16, 32]}
        },
        "required": ["path", "sha256", "worker_concurrency"]
      }
    },
    "suite_canaries": {
      "type": "array",
      "prefixItems": [
        {"const": "banking"}, {"const": "slack"},
        {"const": "travel"}, {"const": "workspace"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "four_suite_canary_complete": {"const": true},
    "canary_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "unresolved_http_429_or_503": {"const": 0},
    "worker_failures": {"const": 0},
    "runtime_policy_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_infra_file_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["files", "aggregate_sha256"]
    },
    "blind_health_ledgers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/file_ref"}},
    "resource_ledgers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/file_ref"}},
    "per_model": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/per_model"}},
    "blind_only": {"const": true},
    "formal_results_written": {"const": false},
    "score_results_written": {"const": false}
  },
  "required": [
    "schema_version", "status", "created_at", "stages", "stage_receipts",
    "suite_canaries", "four_suite_canary_complete", "canary_matrix_sha256",
    "unresolved_http_429_or_503", "worker_failures",
    "runtime_policy_semantic_sha256", "runtime_infra_file_sha256", "runtime_code",
    "blind_health_ledgers", "resource_ledgers", "per_model", "blind_only",
    "formal_results_written", "score_results_written"
  ]
}
