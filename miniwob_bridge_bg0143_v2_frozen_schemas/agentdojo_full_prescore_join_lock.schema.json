{
  "$id": "evidence_system/schemas/agentdojo_full_prescore_join_lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentdojo_full_prescore_join_lock",
  "description": "Final score authorization binding execution, checklist, evidence acceptance, and promotion locks.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_full_prescore_join_lock/v1"},
    "join_id": {"const": "agentdojo_full_v1.2.2_direct_prescore_join"},
    "lock_status": {"const": "locked"},
    "locked_at": {"type": "string", "minLength": 1},
    "result_namespace": {"const": "agentdojo_full_v1.2.2_direct"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_lock": {"$ref": "#/$defs/path_lock"},
        "checklist_freeze_lock": {"$ref": "#/$defs/path_lock"},
        "evidence_acceptance_index": {"$ref": "#/$defs/path_lock"},
        "promotion_receipt": {"$ref": "#/$defs/path_lock"},
        "score_prompt": {"$ref": "#/$defs/path_lock"},
        "score_schema": {"$ref": "#/$defs/path_lock"},
        "formal_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "file_count": {"type": "integer", "minimum": 1}
          },
          "required": ["path", "tree_sha256", "file_count"]
        },
        "score_output_precondition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roots": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"path": {"$ref": "#/$defs/path"}, "file_count": {"const": 0}},
                "required": ["path", "file_count"]
              }
            },
            "all_empty": {"const": true}
          },
          "required": ["roots", "all_empty"]
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_count": {"const": 949},
            "agents_per_case": {"const": 3},
            "score_task_count": {"const": 2847},
            "tasks_per_key": {"const": 949},
            "slot_count": {"const": 3},
            "unresolved_evidence": {"const": 0},
            "unresolved_checklists": {"const": 0}
          },
          "required": ["case_count", "agents_per_case", "score_task_count", "tasks_per_key", "slot_count", "unresolved_evidence", "unresolved_checklists"]
        }
      },
      "required": ["execution_lock", "checklist_freeze_lock", "evidence_acceptance_index", "promotion_receipt", "score_prompt", "score_schema", "formal_evidence", "score_output_precondition", "authorization"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "join_id", "lock_status", "locked_at", "result_namespace", "definition", "definition_sha256"],
  "x-step": "Step 3 Schema / Provenance / Validator"
}
