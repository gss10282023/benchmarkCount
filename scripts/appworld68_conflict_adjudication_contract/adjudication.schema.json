{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_unit_id",
    "source_provenance",
    "case_conflict_status",
    "different_outcome_description",
    "official_case_assessment",
    "our_system_assessment",
    "records",
    "source_pointers"
  ],
  "properties": {
    "case_unit_id": {"type": "string"},
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "historical_packet_version",
        "adjudication_source_version",
        "actual_run_version",
        "exact_actual_task_source_available",
        "effect",
        "source_pointers"
      ],
      "properties": {
        "status": {"type": "string", "const": "corrected_0_2_0_source_lock"},
        "historical_packet_version": {"type": "string", "const": "0.1.0"},
        "adjudication_source_version": {"type": "string", "const": "0.2.0"},
        "actual_run_version": {"type": "string", "const": "0.2.0"},
        "exact_actual_task_source_available": {"type": "boolean", "const": true},
        "effect": {"type": "string", "minLength": 20},
        "source_pointers": {"$ref": "#/$defs/pointers"}
      }
    },
    "case_conflict_status": {"enum": ["confirmed_conflict", "not_confirmed", "insufficient"]},
    "different_outcome_description": {"type": ["string", "null"]},
    "official_case_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "category", "description", "source_pointers"],
      "properties": {
        "status": {"enum": ["confirmed_issue", "measurement_limitation", "no_issue_found", "insufficient"]},
        "category": {"enum": ["task_specification", "target_construction", "evaluator_oracle", "reward_wiring", "artifact_provenance", "none"]},
        "description": {"type": "string", "minLength": 20},
        "source_pointers": {"$ref": "#/$defs/pointers"}
      }
    },
    "our_system_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score_set_validity", "hotfix_status", "description", "additional_issues", "source_pointers"],
      "properties": {
        "status": {"type": "string", "const": "confirmed_issue"},
        "score_set_validity": {"type": "string", "const": "invalid_historical_v4_wrong_source_version"},
        "hotfix_status": {"type": "string", "const": "corrected_v5_source_lock"},
        "description": {"type": "string", "minLength": 20},
        "additional_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "status", "record_ids", "description", "source_pointers"],
            "properties": {
              "component": {"enum": ["case_packet", "checklist", "evidence_package", "scorer", "join", "retained_artifact", "conflict_audit_code"]},
              "status": {"enum": ["confirmed_issue", "corrected", "insufficient"]},
              "record_ids": {"type": "array", "items": {"type": "string"}},
              "description": {"type": "string", "minLength": 20},
              "source_pointers": {"$ref": "#/$defs/pointers"}
            }
          }
        },
        "source_pointers": {"$ref": "#/$defs/pointers"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "agent_id", "released_evaluator_label", "audit_status", "confirmed_benchmark_conflict", "relation", "reason", "source_pointers", "non_dispositive_checks"],
        "properties": {
          "task_id": {"type": "string"},
          "agent_id": {"enum": ["Agent A", "Agent B", "Agent C"]},
          "released_evaluator_label": {"enum": ["success", "fail"]},
          "audit_status": {"enum": ["confirmed_conflict", "not_confirmed", "insufficient"]},
          "confirmed_benchmark_conflict": {"type": ["boolean", "null"]},
          "relation": {"enum": ["different_outcome", "same_exact", "same_outcome_weaker_or_under_specified", "indeterminate"]},
          "reason": {"type": "string", "minLength": 20},
          "source_pointers": {"$ref": "#/$defs/pointers"},
          "non_dispositive_checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label_agreement_used_as_proof", "label_disagreement_used_as_proof", "native_verdict_used_as_proof", "stronger_result_used_as_proof", "legacy_packet_used_as_actual_semantics"],
            "properties": {
              "label_agreement_used_as_proof": {"type": "boolean", "const": false},
              "label_disagreement_used_as_proof": {"type": "boolean", "const": false},
              "native_verdict_used_as_proof": {"type": "boolean", "const": false},
              "stronger_result_used_as_proof": {"type": "boolean", "const": false},
              "legacy_packet_used_as_actual_semantics": {"type": "boolean", "const": false}
            }
          }
        }
      }
    },
    "source_pointers": {"$ref": "#/$defs/pointers"}
  },
  "$defs": {
    "pointers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[^:]+::.+$"}
    }
  }
}
