{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_unit_id", "case_analysis", "records"],
  "properties": {
    "case_unit_id": {"type": "string", "minLength": 1},
    "case_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apparent_benchmark_claim",
        "actual_checked_outcome",
        "target_construction_review",
        "evaluator_oracle_review",
        "reward_wiring_aggregation_review",
        "semantic_relation",
        "official_benchmark_assessment",
        "checklist_and_case_packet_assessment",
        "source_pointers"
      ],
      "properties": {
        "apparent_benchmark_claim": {"type": "string", "minLength": 1},
        "actual_checked_outcome": {"type": "string", "minLength": 1},
        "target_construction_review": {"type": "string", "minLength": 1},
        "evaluator_oracle_review": {"type": "string", "minLength": 1},
        "reward_wiring_aggregation_review": {"type": "string", "minLength": 1},
        "semantic_relation": {
          "type": "string",
          "enum": [
            "same_exact",
            "same_outcome_weaker_or_under_specified",
            "different_outcome",
            "indeterminate"
          ]
        },
        "official_benchmark_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "category", "description", "source_pointers"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "no_issue_found",
                "measurement_limitation",
                "confirmed_case_issue",
                "insufficient"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "none",
                "task_specification",
                "target_construction",
                "evaluator_oracle",
                "reward_wiring_aggregation",
                "artifact_or_provenance"
              ]
            },
            "description": {"type": "string", "minLength": 1},
            "source_pointers": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "checklist_and_case_packet_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "description", "source_pointers"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "confirmed_issue", "insufficient"]
            },
            "description": {"type": "string", "minLength": 1},
            "source_pointers": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_pointers": {
          "type": "array",
          "minItems": 8,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "agent_id",
          "released_evaluator_label",
          "audit_status",
          "confirmed_benchmark_conflict",
          "different_outcome_description",
          "reason",
          "semantic_comparison",
          "our_system_review",
          "source_pointers",
          "non_dispositive_checks"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "agent_id": {
            "type": "string",
            "enum": ["Agent A", "Agent B", "Agent C"]
          },
          "released_evaluator_label": {
            "type": "string",
            "enum": ["success", "fail"]
          },
          "audit_status": {
            "type": "string",
            "enum": ["confirmed_conflict", "not_confirmed", "insufficient"]
          },
          "confirmed_benchmark_conflict": {"type": ["boolean", "null"]},
          "different_outcome_description": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1},
          "semantic_comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apparent_claim",
              "actual_checker",
              "target_construction",
              "aggregation",
              "record_binding",
              "relation"
            ],
            "properties": {
              "apparent_claim": {"type": "string", "minLength": 1},
              "actual_checker": {"type": "string", "minLength": 1},
              "target_construction": {"type": "string", "minLength": 1},
              "aggregation": {"type": "string", "minLength": 1},
              "record_binding": {"type": "string", "minLength": 1},
              "relation": {
                "type": "string",
                "enum": [
                  "same_exact",
                  "same_outcome_weaker_or_under_specified",
                  "different_outcome",
                  "indeterminate"
                ]
              }
            }
          },
          "our_system_review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["overall_status", "summary", "issues", "source_pointers"],
            "properties": {
              "overall_status": {
                "type": "string",
                "enum": ["no_issue_found", "confirmed_issue", "insufficient"]
              },
              "summary": {"type": "string", "minLength": 1},
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["component", "description", "source_pointers"],
                  "properties": {
                    "component": {
                      "type": "string",
                      "enum": [
                        "checklist",
                        "case_packet",
                        "evidence_package",
                        "scorer",
                        "released_label_join",
                        "retained_artifact",
                        "conflict_audit_code"
                      ]
                    },
                    "description": {"type": "string", "minLength": 1},
                    "source_pointers": {
                      "type": "array",
                      "minItems": 2,
                      "items": {"type": "string", "minLength": 1}
                    }
                  }
                }
              },
              "source_pointers": {
                "type": "array",
                "minItems": 3,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "source_pointers": {
            "type": "array",
            "minItems": 7,
            "items": {"type": "string", "minLength": 1}
          },
          "non_dispositive_checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label_agreement_used_as_conflict_proof",
              "label_disagreement_used_as_conflict_proof",
              "native_verdict_used_as_conflict_proof",
              "stronger_result_used_as_conflict_proof"
            ],
            "properties": {
              "label_agreement_used_as_conflict_proof": {"type": "boolean", "const": false},
              "label_disagreement_used_as_conflict_proof": {"type": "boolean", "const": false},
              "native_verdict_used_as_conflict_proof": {"type": "boolean", "const": false},
              "stronger_result_used_as_conflict_proof": {"type": "boolean", "const": false}
            }
          }
        }
      }
    }
  }
}
