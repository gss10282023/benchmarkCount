# Allow only the installed Codex native binary to create the user namespace
# used by its Linux command sandbox. The profile remains otherwise unconfined;
# Codex applies the actual read-only/workspace-write policy inside that namespace.

abi <abi/4.0>,
include <tunables/global>

profile neurips-codex /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex flags=(unconfined) {
  userns,

  include if exists <local/neurips-codex>
}
