#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "neurips-draft-login must run as root." >&2
  exit 2
fi

if [[ ${1:-} == "--status" && $# -eq 1 ]]; then
  exec sudo -u draftsvc \
    env HOME=/srv/neurips-draft/home \
    CODEX_HOME=/srv/neurips-draft/home/.codex \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    codex login status
fi
if [[ $# -ne 0 ]]; then
  echo "Usage: neurips-draft-login [--status]" >&2
  exit 2
fi

exec sudo -u draftsvc \
  env HOME=/srv/neurips-draft/home \
  CODEX_HOME=/srv/neurips-draft/home/.codex \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  codex login --device-auth
