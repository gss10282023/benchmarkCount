#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "neurips-draft-init must run as root." >&2
  exit 2
fi
if [[ $# -ne 1 ]]; then
  echo "Usage: neurips-draft-init JOB_ID" >&2
  exit 2
fi

job_id=$1
if [[ ! $job_id =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$ ]]; then
  echo "JOB_ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,47}." >&2
  exit 2
fi

job_root=/srv/neurips-draft/jobs/$job_id
case_packet_root=$job_root/case_packets

if [[ -e $job_root/results/_batch_summary.json ]]; then
  echo "Job already has a batch summary; choose a new JOB_ID: $job_id" >&2
  exit 2
fi

install -d -m 0750 -o draftsvc -g draftsvc "$case_packet_root"
echo "job_id=$job_id"
echo "upload_to=$case_packet_root/"
