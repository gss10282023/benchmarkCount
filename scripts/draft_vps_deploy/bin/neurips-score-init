#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "neurips-score-init must run as root." >&2
  exit 2
fi
if [[ $# -ne 1 ]]; then
  echo "Usage: neurips-score-init JOB_ID" >&2
  exit 2
fi

job_id=$1
if [[ ! $job_id =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$ ]]; then
  echo "JOB_ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,47}." >&2
  exit 2
fi

job_root=/srv/neurips-score/jobs/$job_id
task_root=$job_root/tasks
if [[ -e $job_root ]]; then
  echo "Score job already exists; choose a new JOB_ID: $job_id" >&2
  exit 2
fi

install -d -m 0755 -o root -g root "$job_root"
install -d -m 0750 -o draftsvc -g draftsvc "$task_root"

echo "job_id=$job_id"
echo "upload_to=$task_root/"
echo "layout=<task_id>/checklist.yaml + <task_id>/evidence/"
