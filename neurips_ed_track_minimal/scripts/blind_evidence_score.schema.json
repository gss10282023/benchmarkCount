{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind_evidence_score.schema.json",
  "title": "BlindEvidenceScore",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_unit_id",
    "blind_mode",
    "native",
    "stronger"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "blind_evidence_score_v1"
    },
    "case_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "blind_mode": {
      "type": "boolean",
      "const": true
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason", "pointers", "test_checks"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["S", "F", "U"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "pointers": {
          "$ref": "#/$defs/Pointers"
        },
        "test_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      }
    },
    "stronger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason", "pointers", "condition_checks"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["NA", "S", "F", "U"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "pointers": {
          "$ref": "#/$defs/Pointers"
        },
        "condition_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      }
    }
  },
  "$defs": {
    "Pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason", "pointers"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["supported", "contradicted", "undecided"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "pointers": {
          "$ref": "#/$defs/Pointers"
        }
      }
    }
  }
}
