{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_checklist_review.schema.json",
  "title": "CaseChecklistModelReviewReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_unit_id",
    "decision",
    "unresolved_findings",
    "case_packet_path",
    "case_packet_sha256",
    "checklist_path",
    "checklist_sha256",
    "draft_prompt_path",
    "draft_prompt_sha256",
    "checklist_schema_path",
    "checklist_schema_sha256",
    "review_prompt_path",
    "review_prompt_sha256",
    "review_schema_path",
    "review_schema_sha256",
    "deterministic_review",
    "model_review",
    "reviewer_config",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "case_checklist_model_review/v1"},
    "case_unit_id": {"$ref": "#/$defs/NonEmptyString"},
    "decision": {"type": "string", "enum": ["accept", "revise"]},
    "unresolved_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/NonEmptyString"}
    },
    "case_packet_path": {"$ref": "#/$defs/NonEmptyString"},
    "case_packet_sha256": {"$ref": "#/$defs/Sha256"},
    "checklist_path": {"$ref": "#/$defs/NonEmptyString"},
    "checklist_sha256": {"$ref": "#/$defs/Sha256"},
    "draft_prompt_path": {"$ref": "#/$defs/NonEmptyString"},
    "draft_prompt_sha256": {"$ref": "#/$defs/Sha256"},
    "checklist_schema_path": {"$ref": "#/$defs/NonEmptyString"},
    "checklist_schema_sha256": {"$ref": "#/$defs/Sha256"},
    "review_prompt_path": {"$ref": "#/$defs/NonEmptyString"},
    "review_prompt_sha256": {"$ref": "#/$defs/Sha256"},
    "review_schema_path": {"$ref": "#/$defs/NonEmptyString"},
    "review_schema_sha256": {"$ref": "#/$defs/Sha256"},
    "deterministic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/NonEmptyString"}
        }
      }
    },
    "model_review": {"$ref": "#/$defs/ModelReviewBody"},
    "reviewer_config": {"$ref": "#/$defs/ReviewerConfig"},
    "reviewed_at": {"type": "string", "format": "date-time", "minLength": 1}
  },
  "$defs": {
    "NonEmptyString": {"type": "string", "minLength": 1},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ReviewerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "auth_mode",
        "codex_cli_version",
        "model",
        "reasoning_effort",
        "sandbox",
        "ephemeral",
        "ignore_user_config",
        "model_verbosity",
        "timeout_seconds"
      ],
      "properties": {
        "provider": {"const": "codex_cli"},
        "auth_mode": {"const": "codex_login"},
        "codex_cli_version": {"$ref": "#/$defs/NonEmptyString"},
        "model": {"$ref": "#/$defs/NonEmptyString"},
        "reasoning_effort": {
          "type": "string",
          "enum": ["minimal", "low", "medium", "high", "xhigh"]
        },
        "sandbox": {"const": "read-only"},
        "ephemeral": {"const": true},
        "ignore_user_config": {"const": true},
        "model_verbosity": {"const": "low"},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "ModelReviewBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "checklist_items", "blocking_findings"],
      "properties": {
        "decision": {"type": "string", "enum": ["accept", "revise"]},
        "checklist_items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/ReviewChecklistItem"}
        },
        "blocking_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/BlockingFinding"}
        },
        "revised_checklist": {"$ref": "#/$defs/ChecklistBody"}
      }
    },
    "ReviewChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rationale", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/ReviewItemId"},
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "rationale": {"$ref": "#/$defs/NonEmptyString"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/NonEmptyString"}
        }
      }
    },
    "ReviewItemId": {
      "type": "string",
      "enum": [
        "identity_and_scope",
        "native_user_goal",
        "native_evaluator_semantics",
        "paired_arm_composition",
        "decisive_post_run_evidence",
        "source_support_pointers",
        "stronger_conditions",
        "schema_guardrail_minimality"
      ]
    },
    "BlockingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checklist_item_id", "message", "required_change", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/NonEmptyString"},
        "checklist_item_id": {"$ref": "#/$defs/ReviewItemId"},
        "message": {"$ref": "#/$defs/NonEmptyString"},
        "required_change": {"$ref": "#/$defs/NonEmptyString"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/NonEmptyString"}
        }
      }
    },
    "ChecklistBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "stronger"],
      "properties": {
        "native": {"$ref": "#/$defs/NativeChecklist"},
        "stronger": {"$ref": "#/$defs/StrongerChecklist"}
      }
    },
    "NativeChecklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_goal",
        "benchmark_success",
        "checked_by",
        "decisive_artifacts",
        "success_if",
        "fail_if",
        "undecided_if"
      ],
      "properties": {
        "user_goal": {"$ref": "#/$defs/JustifiedText"},
        "benchmark_success": {"$ref": "#/$defs/JustifiedText"},
        "checked_by": {"$ref": "#/$defs/JustifiedText"},
        "decisive_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ArtifactQuestion"}
        },
        "success_if": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/JustifiedText"}
        },
        "fail_if": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/JustifiedText"}
        },
        "undecided_if": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/JustifiedText"}
        }
      }
    },
    "StrongerChecklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additional_conditions"],
      "properties": {
        "additional_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/StrongerCondition"}
        }
      }
    },
    "JustifiedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"$ref": "#/$defs/NonEmptyString"},
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/NonEmptyString"}
        },
        "rationale": {"$ref": "#/$defs/NonEmptyString"}
      },
      "anyOf": [
        {"required": ["support"]},
        {"required": ["rationale"]}
      ]
    },
    "ArtifactQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "question", "support"],
      "properties": {
        "artifact": {"$ref": "#/$defs/NonEmptyString"},
        "question": {"$ref": "#/$defs/NonEmptyString"},
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/NonEmptyString"}
        }
      }
    },
    "StrongerCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "rationale", "decisive_artifacts", "support"],
      "properties": {
        "id": {"$ref": "#/$defs/NonEmptyString"},
        "text": {"$ref": "#/$defs/NonEmptyString"},
        "rationale": {"$ref": "#/$defs/NonEmptyString"},
        "decisive_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ArtifactQuestion"}
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/NonEmptyString"}
        }
      }
    }
  }
}
