{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "androidworld_root_agent_case_verdict_v1.schema.json",
  "title": "External root-agent case verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_unit_id",
    "task_id",
    "selection_rank",
    "verdict",
    "reviewer",
    "review_authority",
    "human_reviewed",
    "reviewed_at",
    "review_method",
    "authority_attestation",
    "notes",
    "issues",
    "checks",
    "input_bindings",
    "promotion_authorized_by_model_proposal",
    "verdict_sha256"
  ],
  "properties": {
    "schema_version": {"const": "androidworld_root_agent_case_verdict/v1"},
    "case_unit_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "selection_rank": {"type": "integer", "minimum": 0, "maximum": 115},
    "verdict": {"enum": ["accepted", "rejected"]},
    "reviewer": {"const": "Codex/root_agent"},
    "review_authority": {"const": "external_root_agent_case_verdict"},
    "human_reviewed": {"const": false},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_method": {"const": "independent_case_by_case_evidence_review"},
    "authority_attestation": {
      "const": "I independently inspected this case and take root-agent responsibility for this verdict."
    },
    "notes": {"type": "string", "minLength": 20},
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "schema_guardrails",
        "llm_provenance",
        "support_pointers",
        "user_goal",
        "evaluator_success",
        "fail",
        "undecided",
        "decisive_artifacts",
        "stronger_conditions",
        "metadata_conflict_disposition"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/check"},
        "schema_guardrails": {"$ref": "#/$defs/check"},
        "llm_provenance": {"$ref": "#/$defs/check"},
        "support_pointers": {"$ref": "#/$defs/check"},
        "user_goal": {"$ref": "#/$defs/check"},
        "evaluator_success": {"$ref": "#/$defs/check"},
        "fail": {"$ref": "#/$defs/check"},
        "undecided": {"$ref": "#/$defs/check"},
        "decisive_artifacts": {"$ref": "#/$defs/check"},
        "stronger_conditions": {"$ref": "#/$defs/check"},
        "metadata_conflict_disposition": {"$ref": "#/$defs/check"}
      }
    },
    "input_bindings": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {"$ref": "#/$defs/binding"}
    },
    "promotion_authorized_by_model_proposal": {"const": false},
    "verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pointer", "finding"],
      "properties": {
        "source": {
          "enum": [
            "packet",
            "effective_checklist_yaml",
            "effective_checklist_json",
            "automatic_qc",
            "effective_origin",
            "repair_provenance",
            "semantic_proposal",
            "semantic_result",
            "semantic_receipt",
            "semantic_review_prelock",
            "independent_validation"
          ]
        },
        "pointer": {"type": "string", "pattern": "^(?:/|line:|section:).+"},
        "finding": {"type": "string", "minLength": 8}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "notes": {"type": "string", "minLength": 8},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
