{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "androidworld_checklist_semantic_review_proposal.schema.json",
  "title": "AndroidWorld checklist semantic-review proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_unit_id",
    "domain",
    "task_id",
    "review_authority",
    "promotion_authorized",
    "input_bindings",
    "review_configuration",
    "review",
    "proposal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "androidworld_checklist_semantic_review_proposal/v1"
    },
    "case_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "const": "androidworld"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "review_authority": {
      "const": "independent_model_proposal_only"
    },
    "promotion_authorized": {
      "const": false
    },
    "input_bindings": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/BindingOrBindingMap"
      }
    },
    "review_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "auth_mode",
        "model",
        "model_version_claim",
        "model_version_evidence_note",
        "reasoning_effort",
        "sandbox",
        "independent_ephemeral_session",
        "prompt",
        "proposal_schema",
        "model_output_schema_sha256",
        "prelock",
        "request_started_at",
        "response_completed_at",
        "response_id"
      ],
      "properties": {
        "provider": {
          "const": "codex_cli"
        },
        "auth_mode": {
          "const": "codex_login"
        },
        "model": {
          "const": "gpt-5.6-sol"
        },
        "model_version_claim": {
          "const": null
        },
        "model_version_evidence_note": {
          "const": "Codex CLI does not expose an immutable backend model snapshot."
        },
        "reasoning_effort": {
          "const": "xhigh"
        },
        "sandbox": {
          "const": "read-only"
        },
        "independent_ephemeral_session": {
          "const": true
        },
        "prompt": {
          "$ref": "#/$defs/FileBinding"
        },
        "proposal_schema": {
          "$ref": "#/$defs/FileBinding"
        },
        "model_output_schema_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prelock": {
          "$ref": "#/$defs/FileBinding"
        },
        "request_started_at": {
          "type": "string",
          "minLength": 1
        },
        "response_completed_at": {
          "type": "string",
          "minLength": 1
        },
        "response_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "$ref": "#/$defs/ReviewBody"
    },
    "proposal_sha256": {
      "$ref": "#/$defs/Sha256"
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "FileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "BindingOrBindingMap": {
      "oneOf": [
        {
          "$ref": "#/$defs/FileBinding"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/FileBinding"
          }
        }
      ]
    },
    "PacketPointer": {
      "type": "string",
      "pattern": "^(?:case_packet\\.md|derived/canonical_task_semantics\\.json)::\\$\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\[[0-9]+\\])?(?:\\.[A-Za-z_][A-Za-z0-9_-]*(?:\\[[0-9]+\\])?)*$"
    },
    "PacketSupport": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/PacketPointer"
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "RuntimeGoalFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "canonical_runtime_goal",
        "checklist_alignment",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "canonical_runtime_goal": {
          "type": "string",
          "minLength": 1
        },
        "checklist_alignment": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "EvaluatorFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expanded_chain",
        "branch_and_parameter_coverage",
        "checklist_alignment",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "expanded_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch_and_parameter_coverage": {
          "type": "string",
          "minLength": 1
        },
        "checklist_alignment": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "RunnerFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "raw_score_semantics",
        "done_gate_semantics",
        "display_threshold_semantics",
        "checklist_alignment",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "raw_score_semantics": {
          "type": "string",
          "minLength": 1
        },
        "done_gate_semantics": {
          "type": "string",
          "minLength": 1
        },
        "display_threshold_semantics": {
          "type": "string",
          "minLength": 1
        },
        "checklist_alignment": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "FailureFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ordinary_failure_semantics",
        "undecided_only_for_missing_or_unusable_evidence",
        "checklist_alignment",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "ordinary_failure_semantics": {
          "type": "string",
          "minLength": 1
        },
        "undecided_only_for_missing_or_unusable_evidence": {
          "type": "boolean"
        },
        "checklist_alignment": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "ArtifactRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "post_run_available",
        "decisive_for",
        "checklist_coverage",
        "packet_support"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "post_run_available": {
          "type": "boolean"
        },
        "decisive_for": {
          "type": "string",
          "minLength": 1
        },
        "checklist_coverage": {
          "enum": [
            "complete",
            "partial",
            "missing",
            "invalid_source_only"
          ]
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "ArtifactFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifacts",
        "source_code_not_treated_as_run_evidence",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRow"
          }
        },
        "source_code_not_treated_as_run_evidence": {
          "type": "boolean"
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "MetadataFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "conflicts_present",
        "authoritative_resolution",
        "checklist_alignment",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "conflicts_present": {
          "type": "boolean"
        },
        "authoritative_resolution": {
          "type": "string",
          "minLength": 1
        },
        "checklist_alignment": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "RequirementRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_type",
        "requirement",
        "native_evaluator_coverage",
        "native_checklist_coverage",
        "stronger_required",
        "raw_stronger_condition_ids",
        "status",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_type": {
          "enum": [
            "goal_atom",
            "evaluator_atom",
            "runner_gate",
            "metadata_resolution"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "native_evaluator_coverage": {
          "enum": [
            "full",
            "partial",
            "none",
            "not_applicable"
          ]
        },
        "native_checklist_coverage": {
          "enum": [
            "complete",
            "partial",
            "missing"
          ]
        },
        "stronger_required": {
          "type": "boolean"
        },
        "raw_stronger_condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "GoalEvaluatorMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requirements",
        "uncovered_requirement_ids",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RequirementRow"
          }
        },
        "uncovered_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "SupportAuditRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklist_json_path",
        "pointer_value",
        "resolves",
        "supports_claim",
        "conclusion"
      ],
      "properties": {
        "checklist_json_path": {
          "type": "string",
          "pattern": "^\\$\\..+\\.support\\[[0-9]+\\]$"
        },
        "pointer_value": {
          "type": "string",
          "minLength": 1
        },
        "resolves": {
          "type": "boolean"
        },
        "supports_claim": {
          "type": "boolean"
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SupportPointerAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pointers",
        "missing_checklist_support_paths",
        "invalid_pointer_values",
        "unsupported_pointer_values",
        "conclusion"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "pointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SupportAuditRow"
          }
        },
        "missing_checklist_support_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invalid_pointer_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported_pointer_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IssueHistoryResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "issue_sha256",
        "status",
        "conclusion",
        "checklist_support",
        "packet_support"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "issue_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "checklist_support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\$\\..+"
          }
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "IssueHistoryAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "historical_issue_count",
        "resolutions",
        "unresolved_issue_ids",
        "conclusion",
        "packet_support"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "historical_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueHistoryResolution"
          }
        },
        "unresolved_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "check",
        "checklist_json_path",
        "description",
        "required_fix",
        "packet_support"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "check": {
          "enum": [
            "identity",
            "runtime_goal",
            "evaluator_expansion",
            "runner_score_semantics",
            "fail_and_undecided",
            "decisive_post_run_artifacts",
            "goal_evaluator_matrix",
            "metadata_conflict_disposition",
            "issue_history_audit",
            "support_pointer_audit",
            "other"
          ]
        },
        "checklist_json_path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_fix": {
          "type": "string",
          "minLength": 1
        },
        "packet_support": {
          "$ref": "#/$defs/PacketSupport"
        }
      }
    },
    "CorrectedJustifiedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "support",
        "rationale"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CorrectedArtifactQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "question",
        "support"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CorrectedStrongerCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "rationale",
        "decisive_artifacts",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decisive_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CorrectedArtifactQuestion"
          }
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CorrectedChecklist": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_unit_id",
        "domain",
        "task_id",
        "native",
        "stronger"
      ],
      "properties": {
        "schema_version": {
          "const": "case_checklist_v1"
        },
        "case_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "const": "androidworld"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_goal",
            "benchmark_success",
            "checked_by",
            "decisive_artifacts",
            "success_if",
            "fail_if",
            "undecided_if"
          ],
          "properties": {
            "user_goal": {
              "$ref": "#/$defs/CorrectedJustifiedText"
            },
            "benchmark_success": {
              "$ref": "#/$defs/CorrectedJustifiedText"
            },
            "checked_by": {
              "$ref": "#/$defs/CorrectedJustifiedText"
            },
            "decisive_artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/CorrectedArtifactQuestion"
              }
            },
            "success_if": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/CorrectedJustifiedText"
              }
            },
            "fail_if": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/CorrectedJustifiedText"
              }
            },
            "undecided_if": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/CorrectedJustifiedText"
              }
            }
          }
        },
        "stronger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "additional_conditions"
          ],
          "properties": {
            "additional_conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CorrectedStrongerCondition"
              }
            }
          }
        }
      }
    },
    "ReviewBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_status",
        "checks",
        "goal_evaluator_matrix",
        "support_pointer_audit",
        "issue_history_audit",
        "issues",
        "corrected_checklist",
        "correction_summary"
      ],
      "properties": {
        "proposal_status": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "description": "Model proposal only; never a final human acceptance."
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "runtime_goal",
            "evaluator_expansion",
            "runner_score_semantics",
            "fail_and_undecided",
            "decisive_post_run_artifacts",
            "metadata_conflict_disposition"
          ],
          "properties": {
            "identity": {
              "$ref": "#/$defs/Finding"
            },
            "runtime_goal": {
              "$ref": "#/$defs/RuntimeGoalFinding"
            },
