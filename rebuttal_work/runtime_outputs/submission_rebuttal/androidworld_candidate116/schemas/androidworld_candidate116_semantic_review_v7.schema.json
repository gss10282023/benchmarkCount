{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "androidworld_candidate116_semantic_review_v7.schema.json",
  "title": "AndroidWorld candidate116 independent semantic review v7 body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "dimension_audits",
    "claim_audits",
    "support_audits",
    "blocking_findings"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["accept", "reject"]
    },
    "dimension_audits": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/DimensionAudit" }
    },
    "claim_audits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ClaimAudit" }
    },
    "support_audits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SupportAudit" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/BlockingFinding" }
    }
  },
  "$defs": {
    "NonEmptyText": {
      "type": "string",
      "minLength": 12
    },
    "ChecklistPointer": {
      "type": "string",
      "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
    },
    "FindingId": {
      "type": "string",
      "pattern": "^F[0-9]{3}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "evidence_role"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^official/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "evidence_role": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "DimensionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "status",
        "assessment",
        "checklist_pointers",
        "source_evidence",
        "finding_ids"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "enum": [
            "identity_goal_generator",
            "parameter_schema_generator",
            "initialize_task",
            "success_evaluator",
            "evaluator_helpers",
            "runner_environment_layer",
            "runner_task_layer",
            "runner_evaluation_layer",
            "native_completeness_and_accuracy",
            "support_material_entailment",
            "metadata_runtime_conflicts",
            "stronger_necessity_measurability_retention",
            "fail_undecided_semantics",
            "no_omission_or_hallucination"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "assessment": { "$ref": "#/$defs/NonEmptyText" },
        "checklist_pointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ChecklistPointer" }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FindingId" }
        }
      }
    },
    "ClaimAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklist_pointer",
        "text_sha256",
        "status",
        "assessment",
        "source_evidence",
        "finding_ids"
      ],
      "properties": {
        "checklist_pointer": { "$ref": "#/$defs/ChecklistPointer" },
        "text_sha256": { "$ref": "#/$defs/Sha256" },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "assessment": { "$ref": "#/$defs/NonEmptyText" },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FindingId" }
        }
      }
    },
    "SupportAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_pointer",
        "source_pointer",
        "target_claim_pointers",
        "status",
        "entailment",
        "source_evidence",
        "finding_ids"
      ],
      "properties": {
        "support_pointer": { "$ref": "#/$defs/ChecklistPointer" },
        "source_pointer": { "type": "string", "minLength": 1 },
        "target_claim_pointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ChecklistPointer" }
        },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "entailment": { "$ref": "#/$defs/NonEmptyText" },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FindingId" }
        }
      }
    },
    "BlockingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "checklist_pointers",
        "source_evidence",
        "blocking_explanation"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/FindingId" },
        "category": {
          "type": "string",
          "enum": [
            "identity_or_goal",
            "parameters_or_initialization",
            "evaluator_or_helper",
            "runner_semantics",
            "native_misstatement_or_omission",
            "support_does_not_entail",
            "metadata_runtime_conflict",
            "stronger_invalid_or_unmeasurable",
            "fail_or_undecided_incorrect",
            "hallucination",
            "insufficient_source_authority"
          ]
        },
        "checklist_pointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ChecklistPointer" }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "blocking_explanation": { "$ref": "#/$defs/NonEmptyText" }
      }
    }
  }
}
