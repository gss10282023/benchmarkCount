# Step 2 bootstrap environment template.
# Values are intentionally empty. Do not commit real secrets.

OPENROUTER_API_KEY=
EVIDENCE_SYSTEM_ROOT=
EVIDENCE_SYSTEM_CONFIG_DIR=configs
EVIDENCE_SYSTEM_RESULTS_DIR=results

# Optional local-only SSH key path reference. Do not paste private key contents.
EVIDENCE_SYSTEM_SSH_KEY_PATH=

# Score-only batch scoring defaults to the current Codex auth
# ($CODEX_HOME/auth.json or ~/.codex/auth.json), copied into isolated slot homes.
# Optional override:
# 1. Set every slot to API-key mode:
# SCORE_API_KEY_1=
# SCORE_API_KEY_2=
# SCORE_API_KEY_3=
# SCORE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 2. Or set every slot to dedicated Codex-login homes:
# SCORE_CODEX_HOME_1=/abs/path/to/codex-home-1
# SCORE_CODEX_HOME_2=/abs/path/to/codex-home-2
# SCORE_CODEX_HOME_3=/abs/path/to/codex-home-3
# Each SCORE_CODEX_HOME_n must contain auth.json.
SCORE_MODEL=gpt-5.4
SCORE_REASONING_EFFORT=xhigh
SCORE_PRICE_INPUT_PER_1M_TOKENS_USD=
SCORE_PRICE_CACHED_INPUT_PER_1M_TOKENS_USD=
SCORE_PRICE_OUTPUT_PER_1M_TOKENS_USD=
SCORE_PRICE_REASONING_OUTPUT_PER_1M_TOKENS_USD=
