{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_remote_output_precondition_receipt.schema.json",
  "title": "agentdojo_remote_output_precondition_receipt",
  "description": "Fresh pre-lock proof that the sealed raw and blind formal namespaces do not exist on the pinned VPS.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_remote_output_precondition_receipt/v1"},
    "status": {"const": "verified_absent"},
    "checked_at": {"type": "string", "format": "date-time"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_infra": {"$ref": "#/$defs/path_lock"},
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"const": "64.177.120.135"},
            "port": {"const": 22},
            "user": {"const": "benchmark"},
            "fingerprint": {"type": "string", "pattern": "^SHA256:"}
          },
          "required": ["host", "port", "user", "fingerprint"]
        },
        "remote_raw_root": {"type": "string", "pattern": "^/"},
        "blind_aggregate_root": {"type": "string", "pattern": "^/"},
        "runtime_state_root": {"type": "string", "pattern": "^/"},
        "failed_attempt_archive_root": {"type": "string", "pattern": "^/"},
        "retrieval_snapshot_root": {"type": "string", "pattern": "^/"},
        "remote_raw_root_absent": {"const": true},
        "blind_aggregate_root_absent": {"const": true},
        "runtime_state_root_absent": {"const": true},
        "failed_attempt_archive_root_absent": {"const": true},
        "retrieval_snapshot_root_absent": {"const": true},
        "ssh_host_key_checking": {"const": "strict_pinned_ed25519"},
        "probe_exit_code": {"const": 0},
        "probe_output": {"const": "RAW_ABSENT BLIND_ABSENT RUNTIME_ABSENT FAILED_ABSENT SNAPSHOT_ABSENT"},
        "secret_material_recorded": {"const": false},
        "evidence_content_read": {"const": false}
      },
      "required": ["runtime_infra", "endpoint", "remote_raw_root", "blind_aggregate_root", "runtime_state_root", "failed_attempt_archive_root", "retrieval_snapshot_root", "remote_raw_root_absent", "blind_aggregate_root_absent", "runtime_state_root_absent", "failed_attempt_archive_root_absent", "retrieval_snapshot_root_absent", "ssh_host_key_checking", "probe_exit_code", "probe_output", "secret_material_recorded", "evidence_content_read"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "status", "checked_at", "definition", "definition_sha256"]
}
