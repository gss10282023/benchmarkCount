{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_requirement_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_evaluator_output_object_hash": {
          "$ref": "#/$defs/sha256"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "artifact_sha256",
        "contract_requirement_id",
        "official_provenance",
        "verified_evaluator_output_object_hash",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/raw_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "appendix_failure_class": {
      "$ref": "#/$defs/appendix_failure_class"
    },
    "artifact_manifest_path": {
      "$ref": "#/$defs/path"
    },
    "artifact_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attempt_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "benchmark_name": {
      "$ref": "#/$defs/nonempty_string"
    },
    "case_unit_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "diagnostic_status": {
      "$ref": "#/$defs/diagnostic_status"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "domain_display_name": {
      "$ref": "#/$defs/nonempty_string"
    },
    "duration_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "ended_at": {
      "$ref": "#/$defs/timestamp"
    },
    "episode_ids": {
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "type": "array"
    },
    "evidence_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_contract_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "evidence_contract_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "execution_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "final_attempt": {
      "type": "boolean"
    },
    "git_commit_hash": {
      "$ref": "#/$defs/sha256"
    },
    "llm_calls_log_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "machine_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "native_decisive_support": {
      "anyOf": [
        {
          "$ref": "#/$defs/native_decisive_support"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_label": {
      "enum": [
        "success",
        "fail",
        "unknown",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "native_label_used_as_decisive_evidence": {
      "type": "boolean"
    },
    "native_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "openrouter_runtime_policy_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "openrouter_runtime_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "raw_source_path": {
      "$ref": "#/$defs/path"
    },
    "record_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "record_slot_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "run_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "schema_version": {
      "const": "raw_run/v1"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "INFRA_EXCLUDED",
        "EVALUATOR_FAILURE",
        "EVALUATOR_UNSTABLE"
      ],
      "type": "string"
    },
    "task_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "taxonomy_version": {
      "$ref": "#/$defs/nonempty_string"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "domain_display_name",
    "benchmark_name",
    "case_unit_id",
    "task_id",
    "record_slot_id",
    "run_id",
    "attempt_id",
    "final_attempt",
    "seed",
    "agent_id",
    "phase",
    "experiment_type",
    "priority",
    "record_id",
    "episode_ids",
    "status",
    "native_label",
    "native_score",
    "native_label_used_as_decisive_evidence",
    "diagnostic_status",
    "appendix_failure_class",
    "artifact_manifest_path",
    "artifact_manifest_sha256",
    "raw_source_path",
    "started_at",
    "ended_at",
    "duration_seconds",
    "machine_id",
    "git_commit_hash",
    "config_hash",
    "manifest_hash",
    "contract_id",
    "contract_version",
    "contract_hash",
    "taxonomy_version",
    "evidence_contract_id",
    "evidence_contract_version",
    "evidence_contract_hash"
  ],
  "title": "raw_run",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
