{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C",
        "Agent D"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/experiment_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "agents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/agent_id"
          },
          "agent_probe_rationale": {
            "$ref": "#/$defs/agent_probe_rationale"
          },
          "config_hash": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "agent_id",
          "config_hash",
          "agent_probe_rationale"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "agents_config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_locks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_hash_source": {
            "$ref": "#/$defs/path"
          },
          "canonicalization_method": {
            "const": "json_canonical_sha256"
          },
          "contract_draft_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "contract_drafting_llm_call_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "contract_hash": {
            "$ref": "#/$defs/sha256"
          },
          "contract_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "contract_version": {
            "$ref": "#/$defs/nonempty_string"
          },
          "lock_status": {
            "const": "locked"
          },
          "locked_at": {
            "$ref": "#/$defs/timestamp"
          },
          "main_result_eligible": {
            "const": true
          },
          "review_record_id": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "required": [
          "contract_id",
          "contract_version",
          "contract_hash",
          "lock_status",
          "locked_at",
          "review_record_id",
          "contract_drafting_llm_call_id",
          "contract_draft_id",
          "canonicalization_method",
          "main_result_eligible"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contract_locks_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "declared_appendix_diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "declared": {
            "type": "boolean"
          },
          "domain": {
            "$ref": "#/$defs/domain"
          },
          "experiment_type": {
            "$ref": "#/$defs/experiment_type"
          },
          "paper_label": {
            "$ref": "#/$defs/nonempty_string"
          },
          "priority": {
            "$ref": "#/$defs/priority"
          }
        },
        "required": [
          "experiment_type",
          "priority",
          "domain",
          "paper_label",
          "declared"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "deterministic_selection": {
      "$ref": "#/$defs/deterministic_selection"
    },
    "domains": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "case_unit_count": {
            "minimum": 0,
            "type": "integer"
          },
          "claim_scope": {
            "enum": [
              "native_aligned",
              "stronger_measurement",
              "mixed_reported_separately",
              "not_applicable"
            ],
            "type": "string"
          },
          "contract_lock_status": {
            "enum": [
              "draft_required",
              "locked_required_before_scoring",
              "locked",
              "not_applicable"
            ],
            "type": "string"
          },
          "domain": {
            "$ref": "#/$defs/domain"
          },
          "domain_display_name": {
            "$ref": "#/$defs/nonempty_string"
          },
          "experiment_type": {
            "$ref": "#/$defs/experiment_type"
          },
          "official_split_eligible_case_units": {
            "minimum": 0,
            "type": "integer"
          },
          "official_split_exception_id": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "official_split_hash": {
            "$ref": "#/$defs/sha256"
          },
          "priority": {
            "$ref": "#/$defs/priority"
          },
          "planned_record_slot_ids_hash": {
            "$ref": "#/$defs/sha256"
          },
          "record_slot_count": {
            "minimum": 0,
            "type": "integer"
          },
          "stronger_measurement_mapping": {
            "$ref": "#/$defs/mapping"
          }
        },
        "required": [
          "domain",
          "domain_display_name",
          "experiment_type",
          "priority",
          "case_unit_count",
          "record_slot_count",
          "planned_record_slot_ids_hash",
          "official_split_eligible_case_units",
          "official_split_hash",
          "contract_lock_status",
          "claim_scope"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "infra_config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "manifest_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "official_split_exceptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "$ref": "#/$defs/domain"
          },
          "eligible_case_units": {
            "minimum": 0,
            "type": "integer"
          },
          "exception_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "exception_reason": {
            "$ref": "#/$defs/nonempty_string"
          },
          "exception_recorded_before_scoring": {
            "const": true
          },
          "official_split_hash": {
            "$ref": "#/$defs/sha256"
          },
          "required_case_units": {
            "minimum": 100,
            "type": "integer"
          }
        },
        "required": [
          "exception_id",
          "domain",
          "eligible_case_units",
          "required_case_units",
          "official_split_hash",
          "exception_recorded_before_scoring",
          "exception_reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "paper_mapping_path": {
      "$ref": "#/$defs/path"
    },
    "paper_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "required_paper_labels": {
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "experiment_manifest/v1"
    },
    "source_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "draft",
        "locked",
        "frozen",
        "formal_ready"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "created_at",
    "status",
    "paper_mapping_path",
    "paper_mapping_sha256",
    "source_bundle_hash",
    "agents_config_hash",
    "infra_config_hash",
    "deterministic_selection",
    "domains",
    "agents",
    "official_split_exceptions",
    "declared_appendix_diagnostics",
    "required_paper_labels",
    "contract_locks"
  ],
  "title": "experiment_manifest",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
