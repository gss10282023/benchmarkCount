{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_policy_finalization_receipt.schema.json",
  "title": "agentdojo_openrouter_policy_finalization_receipt",
  "description": "Immutable derivation receipt from provisional measurement policy to the finalized validation/formal policy.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "required": ["path", "sha256"]},
    "policy_ref": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "semantic_sha256": {"$ref": "#/$defs/sha256"}, "operational_definition_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["path", "sha256", "semantic_sha256", "operational_definition_sha256"]}
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_policy_finalization_receipt/v1"},
    "status": {"const": "finalized_from_measurement"},
    "created_at": {"type": "string", "format": "date-time"},
    "candidate_runtime_policy": {"$ref": "#/$defs/policy_ref"},
    "measurement_receipt": {"$ref": "#/$defs/file_ref"},
    "finalized_runtime_policy": {"$ref": "#/$defs/policy_ref"},
    "runtime_snapshot": {"type": "object"},
    "secret_material_recorded": {"const": false}
  },
  "required": ["schema_version", "status", "created_at", "candidate_runtime_policy", "measurement_receipt", "finalized_runtime_policy", "runtime_snapshot", "secret_material_recorded"]
}
