{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_formal_execution_namespace_init_receipt.schema.json",
  "title": "agentdojo_formal_execution_namespace_init_receipt",
  "description": "Post-lock create-once identity receipt for all five formal VPS roots and empty local write namespaces.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "remote_root_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["raw", "blind", "runtime", "failed_attempt_archive", "retrieval_snapshot"]},
        "path": {"type": "string", "pattern": "^/"},
        "owner_user": {"type": "string", "minLength": 1},
        "owner_uid": {"type": "integer", "minimum": 0},
        "group_name": {"type": "string", "minLength": 1},
        "group_gid": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["0700", "0750"]},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "nlink": {"type": "integer", "minimum": 2}
      },
      "required": ["role", "path", "owner_user", "owner_uid", "group_name", "group_gid", "mode", "device", "inode", "nlink"]
    },
    "remote_marker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["raw", "blind", "runtime", "failed_attempt_archive", "retrieval_snapshot"]},
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "owner_user": {"type": "string", "minLength": 1},
        "owner_uid": {"type": "integer", "minimum": 0},
        "group_name": {"type": "string", "minLength": 1},
        "group_gid": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["0600", "0640"]},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "nlink": {"const": 1}
      },
      "required": ["role", "path", "sha256", "size_bytes", "owner_user", "owner_uid", "group_name", "group_gid", "mode", "device", "inode", "nlink"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_formal_execution_namespace_init_receipt/v2"},
    "status": {"const": "initialized_empty_namespaces"},
    "initialized_at": {"type": "string", "format": "date-time"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_lock": {"$ref": "#/$defs/path_lock"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "plan_index": {"$ref": "#/$defs/path_lock"},
        "remote_output_precondition_receipt": {"$ref": "#/$defs/path_lock"},
        "final_runtime_deployment_receipt": {"$ref": "#/$defs/path_lock"},
        "runtime_infra": {"$ref": "#/$defs/path_lock"},
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"const": "64.177.120.135"},
            "port": {"const": 22},
            "user": {"const": "benchmark"},
            "fingerprint": {"type": "string", "pattern": "^SHA256:"}
          },
          "required": ["host", "port", "user", "fingerprint"]
        },
        "remote_raw_root": {"type": "string", "pattern": "^/"},
        "blind_aggregate_root": {"type": "string", "pattern": "^/"},
        "runtime_state_root": {"type": "string", "pattern": "^/"},
        "failed_attempt_archive_root": {"type": "string", "pattern": "^/"},
        "retrieval_snapshot_root": {"type": "string", "pattern": "^/"},
        "roots_previously_absent": {"const": true},
        "remote_root_identities": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/remote_root_identity"},
            {"$ref": "#/$defs/remote_root_identity"},
            {"$ref": "#/$defs/remote_root_identity"},
            {"$ref": "#/$defs/remote_root_identity"},
            {"$ref": "#/$defs/remote_root_identity"}
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "namespace_markers": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/remote_marker"},
            {"$ref": "#/$defs/remote_marker"},
            {"$ref": "#/$defs/remote_marker"},
            {"$ref": "#/$defs/remote_marker"},
            {"$ref": "#/$defs/remote_marker"}
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "namespace_transaction_id": {"type": "string", "pattern": "^ns-[a-f0-9]{64}$"},
        "remote_create_once": {"const": true},
        "runtime_sync_after_init_forbidden": {"const": true},
        "local_staging_root": {"type": "string", "minLength": 1},
        "local_staging_file_count": {"const": 0},
        "local_blind_metadata_root": {"type": "string", "minLength": 1},
        "local_blind_metadata_file_count_before_receipt": {"const": 0},
        "score_result_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "score_result_file_count": {"const": 0},
        "secret_material_recorded": {"const": false}
      },
      "required": ["execution_lock", "execution_policy_sha256", "plan_index", "remote_output_precondition_receipt", "final_runtime_deployment_receipt", "runtime_infra", "endpoint", "remote_raw_root", "blind_aggregate_root", "runtime_state_root", "failed_attempt_archive_root", "retrieval_snapshot_root", "roots_previously_absent", "remote_root_identities", "namespace_markers", "namespace_transaction_id", "remote_create_once", "runtime_sync_after_init_forbidden", "local_staging_root", "local_staging_file_count", "local_blind_metadata_root", "local_blind_metadata_file_count_before_receipt", "score_result_roots", "score_result_file_count", "secret_material_recorded"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "status", "initialized_at", "definition", "definition_sha256"]
}
