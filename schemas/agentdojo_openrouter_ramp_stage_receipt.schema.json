{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_ramp_stage_receipt.schema.json",
  "title": "agentdojo_openrouter_ramp_stage_receipt",
  "description": "Machine-recomputed, evidence-blind health receipt for one AgentDojo OpenRouter concurrency stage.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "workload_job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "suite": {"enum": ["banking", "slack", "travel", "workspace"]},
        "opaque_case_identity_sha256": {"$ref": "#/$defs/sha256"},
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "job_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "ordinal", "suite", "opaque_case_identity_sha256",
        "model_config_sha256", "job_identity_sha256"
      ]
    },
    "per_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "returned_provider_model_identity_sha256s": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "request_count": {"type": "integer", "minimum": 1},
        "success_count": {"type": "integer", "minimum": 0},
        "successful_request_parameter_proof": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "temperature_present": {"type": "boolean"},
            "top_p_present": {"type": "boolean"},
            "max_tokens_present": {"type": "boolean"},
            "seed_present": {"type": "boolean"},
            "native_tools_absent": {"type": "boolean"},
            "native_tool_choice_absent": {"type": "boolean"},
            "prompt_based_tool_protocol": {"const": true}
          },
          "required": [
            "temperature_present", "top_p_present", "max_tokens_present",
            "seed_present", "native_tools_absent", "native_tool_choice_absent",
            "prompt_based_tool_protocol"
          ]
        }
      },
      "required": [
        "model_config_sha256", "returned_provider_model_identity_sha256s",
        "request_count", "success_count", "successful_request_parameter_proof"
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_ramp_stage_receipt/v2"},
    "status": {"enum": ["passed", "held_at_prior_safe", "measured_with_threshold_breach"]},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["disposable_preflight", "exploratory_measurement", "formal_execution"]},
    "worker_concurrency": {"enum": [4, 8, 16, 32]},
    "locked_workers": {"enum": [4, 8, 16, 32]},
    "effective_workers": {"enum": [4, 8, 16, 32]},
    "ran_at_locked_target": {"type": "boolean"},
    "prior_safe_workers": {"enum": [4, 8, 16, 32]},
    "resulting_safe_workers": {"enum": [4, 8, 16, 32]},
    "runtime_policy_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_policy": {"type": "object", "minProperties": 1},
    "runtime_infra_file_sha256": {"$ref": "#/$defs/sha256"},
    "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
        "host_boot_id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"}
      },
      "required": ["session_id", "host_boot_id"]
    },
    "runtime_code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_execution_runtime_snapshot/v1"},
        "files": {
          "type": "object",
          "minProperties": 8,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "files", "aggregate_sha256"]
    },
    "stage_workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_openrouter_ramp_stage_workload/v2"},
        "worker_concurrency": {"enum": [4, 8, 16, 32]},
        "planned_job_count": {"type": "integer", "minimum": 4},
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {"const": "agentdojo_disposable_stage_round_robin/v1"},
            "manifest_path": {"type": "string", "minLength": 1},
            "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
            "agents_config_path": {"type": "string", "minLength": 1},
            "agents_config_file_sha256": {"$ref": "#/$defs/sha256"},
            "source_bundle_path": {"type": "string", "minLength": 1},
            "source_bundle_file_sha256": {"$ref": "#/$defs/sha256"},
            "selection_seed_sha256": {"$ref": "#/$defs/sha256"},
            "workload_kind": {"enum": ["global_mixed_canary", "per_model_ramp"]},
            "model_ordinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
            "model_batch_schedule": {
              "type": ["array", "null"],
              "minItems": 3, "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "model_ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
                  "start_ordinal": {"type": "integer", "minimum": 0, "maximum": 8},
                  "job_count": {"const": 4}
                },
                "required": ["model_ordinal", "start_ordinal", "job_count"]
              }
            },
            "result_namespace": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "required": [
            "algorithm", "manifest_path", "manifest_file_sha256",
            "agents_config_path", "agents_config_file_sha256", "source_bundle_path",
            "source_bundle_file_sha256", "selection_seed_sha256", "result_namespace"
            , "workload_kind", "model_ordinal", "model_batch_schedule"
          ]
        },
        "jobs": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/workload_job"}}
      },
      "required": ["schema_version", "worker_concurrency", "planned_job_count", "generation", "jobs"]
    },
    "stage_workload_sha256": {"$ref": "#/$defs/sha256"},
    "blind_health_ledger": {"$ref": "#/$defs/file_ref"},
    "resource_ledger": {"$ref": "#/$defs/file_ref"},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_attempts": {
          "type": "integer", "minimum": 1,
          "description": "Real OpenRouter request attempts recorded for this stage. Exploratory fatal/blocked workers may fail before requesting, so this can be lower than planned_jobs; a stage with zero real requests is rejected by the receipt builder."
        },
        "planned_jobs": {"type": "integer", "minimum": 4},
        "unique_completed_jobs": {"type": "integer", "minimum": 0},
        "worker_completions": {"type": "integer", "minimum": 0},
        "worker_failures": {
          "type": "integer", "minimum": 0,
          "description": "Unique worker completions whose outcome is not success, including exploratory fatal/blocked completions that occurred before any request attempt."
        },
        "missing_successful_jobs": {"type": "integer", "minimum": 0},
        "http_429": {"type": "integer", "minimum": 0},
        "http_503": {"type": "integer", "minimum": 0},
        "unresolved_http_429_or_503": {
          "type": "integer", "minimum": 0,
          "description": "Legacy promotion counter: unresolved fatal/blocked request chains plus exploratory fatal/blocked worker completions with no request attempt. This field does not attribute a no-request failure to HTTP 429 or 503; use http_429/http_503 for exact HTTP counts."
        },
        "unresolved_request_chains": {
          "type": "integer", "minimum": 0,
          "description": "Request chains whose latest request attempt remains fatal_error, blocked, HTTP 429, or HTTP 503; excludes completions with no request attempt."
        },
        "non_request_worker_failures": {
          "type": "integer", "minimum": 0,
          "description": "Exploratory fatal_error or blocked worker completions for locked jobs that emitted no request_attempt. Always zero for a valid finalized/non-exploratory receipt."
        },
        "recovered_429_503_chains": {"type": "integer", "minimum": 0},
        "recovered_429_503_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_consecutive_429_503": {"type": "integer", "minimum": 0},
        "max_retry_delay_seconds_per_chain": {"type": "number", "minimum": 0},
        "max_rolling_rpm": {"type": "integer", "minimum": 1},
        "max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
        "max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
        "measurement_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "requested_job_throughput_per_minute": {"type": "number", "exclusiveMinimum": 0},
        "achieved_successful_job_throughput_per_minute": {"type": "number", "minimum": 0},
        "achieved_admission_reservation_units_throughput_per_minute": {"type": "number", "exclusiveMinimum": 0},
        "provider_error_categories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http_429_openrouter_or_upstream_unspecified": {"type": "integer", "minimum": 0},
            "http_503_service_origin_unspecified": {"type": "integer", "minimum": 0},
            "transport_or_non_http": {
              "type": "integer", "minimum": 0,
              "description": "Non-success request attempts without an HTTP status plus exploratory fatal/blocked worker completions with no request attempt; no HTTP status is inferred for either category."
            }
          },
          "required": [
            "http_429_openrouter_or_upstream_unspecified",
            "http_503_service_origin_unspecified",
            "transport_or_non_http"
          ]
        },
        "max_active_requests": {"type": "integer", "minimum": 1},
        "minimum_required_active_requests": {"type": "integer", "minimum": 1},
        "resource_samples": {"type": "integer", "minimum": 1},
        "max_cpu_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "max_memory_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "max_swap_used_bytes": {"type": "integer", "minimum": 0},
        "max_active_worker_processes": {"type": "integer", "minimum": 1},
        "minimum_required_active_worker_processes": {"type": "integer", "minimum": 1},
        "max_simultaneous_active_workers_and_requests": {"type": "integer", "minimum": 1},
        "minimum_required_simultaneous_load": {"type": "integer", "minimum": 1},
        "thresholds_passed": {"type": "boolean"},
        "per_model": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"$ref": "#/$defs/per_model"}
        }
      },
      "required": [
        "request_attempts", "planned_jobs", "unique_completed_jobs",
        "worker_completions", "worker_failures", "missing_successful_jobs", "http_429", "http_503",
        "unresolved_http_429_or_503", "unresolved_request_chains",
        "non_request_worker_failures", "recovered_429_503_chains",
        "recovered_429_503_fraction", "max_consecutive_429_503",
        "max_retry_delay_seconds_per_chain", "max_rolling_rpm",
        "max_rolling_admission_reservation_units_per_minute",
        "max_rolling_provider_actual_tokens_per_minute",
        "measurement_duration_seconds", "requested_job_throughput_per_minute",
        "achieved_successful_job_throughput_per_minute",
        "achieved_admission_reservation_units_throughput_per_minute", "provider_error_categories",
        "max_active_requests", "minimum_required_active_requests", "resource_samples",
        "max_cpu_percent", "max_memory_percent", "max_swap_used_bytes",
        "max_active_worker_processes", "minimum_required_active_worker_processes",
        "max_simultaneous_active_workers_and_requests", "minimum_required_simultaneous_load",
        "thresholds_passed",
        "per_model"
      ]
    },
    "blind_only": {"const": true}
  },
  "required": [
    "schema_version", "status", "created_at", "scope", "worker_concurrency",
    "locked_workers", "effective_workers", "ran_at_locked_target",
    "prior_safe_workers", "resulting_safe_workers",
    "runtime_policy_semantic_sha256", "runtime_policy", "runtime_infra_file_sha256",
    "credential_fingerprint_sha256",
    "runtime_session",
    "runtime_code", "stage_workload", "stage_workload_sha256",
    "blind_health_ledger", "resource_ledger", "observed", "blind_only"
  ]
}
