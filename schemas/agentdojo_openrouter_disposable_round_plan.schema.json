{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_disposable_round_plan.schema.json",
  "title": "agentdojo_openrouter_disposable_round_plan",
  "description": "Immutable 13-stage, 192-slot plan for one of the two evidence-blind OpenRouter validation rounds.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "operational_definition_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256", "semantic_sha256", "operational_definition_sha256"]
    },
    "artifact_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 12},
        "root": {"type": "string", "minLength": 1},
        "blind_health_ledger": {"type": "string", "minLength": 1},
        "resource_ledger": {"type": "string", "minLength": 1},
        "stage_receipt": {"type": "string", "minLength": 1}
      },
      "required": ["ordinal", "root", "blind_health_ledger", "resource_ledger", "stage_receipt"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_disposable_round_plan/v1"},
    "status": {"const": "locked"},
    "created_at": {"type": "string", "format": "date-time"},
    "definition_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derivation": {"const": "definition_sha256_full_hex/v1"},
        "root": {"type": "string", "minLength": 1},
        "must_be_absent_at_initial_publication": {"const": true},
        "limiter_database": {"type": "string", "minLength": 1},
        "controller_lifecycle_lock": {"type": "string", "minLength": 1},
        "pre_credential_receipt": {"type": "string", "minLength": 1},
        "pre_credential_health_ledger": {"type": "string", "minLength": 1},
        "post_credential_receipt": {"type": ["string", "null"], "minLength": 1},
        "post_credential_health_ledger": {"type": ["string", "null"], "minLength": 1},
        "aggregate_receipt": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array", "minItems": 13, "maxItems": 13,
          "items": {"$ref": "#/$defs/artifact_stage"}
        }
      },
      "required": ["derivation", "root", "must_be_absent_at_initial_publication", "limiter_database", "controller_lifecycle_lock", "pre_credential_receipt", "pre_credential_health_ledger", "post_credential_receipt", "post_credential_health_ledger", "aggregate_receipt", "stages"]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round_kind": {"enum": ["exploratory_measurement", "finalized_validation"]},
        "receipt_scope": {"enum": ["exploratory_measurement", "disposable_preflight"]},
        "runtime_policy": {"$ref": "#/$defs/policy_ref"},
        "runtime_infra": {"$ref": "#/$defs/file_ref"},
        "agents_config": {"$ref": "#/$defs/file_ref"},
        "manifest": {"$ref": "#/$defs/file_ref"},
        "source_bundle": {"$ref": "#/$defs/file_ref"},
        "execution_budget_plan": {"$ref": "#/$defs/file_ref"},
        "bridge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measurement_receipt": {"type": ["object", "null"]},
            "policy_finalization_receipt": {"type": ["object", "null"]}
          },
          "required": ["measurement_receipt", "policy_finalization_receipt"]
        },
        "result_namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "stage_order_algorithm": {"const": "mixed_then_stage_major_models_v1"},
        "stages": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ordinal": {"type": "integer", "minimum": 0, "maximum": 12},
              "workload_kind": {"enum": ["global_mixed_canary", "per_model_ramp"]},
              "locked_workers": {"enum": [4, 8, 16, 32]},
              "effective_workers": {"type": ["integer", "null"], "minimum": 4, "maximum": 32},
              "effective_workers_rule": {
                "enum": [
                  "locked_mixed_canary/v1",
                  "prior_safe_adaptive_hold/v1",
                  "min_locked_and_finalized_per_model_safe/v1"
                ]
              },
              "model_ordinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
              "receipt_scope": {"enum": ["exploratory_measurement", "disposable_preflight"]},
              "planned_jobs": {"type": "integer", "minimum": 4, "maximum": 32},
              "workload": {"type": "object", "minProperties": 1},
              "workload_sha256": {"$ref": "#/$defs/sha256"}
            },
            "required": ["ordinal", "workload_kind", "locked_workers", "effective_workers", "effective_workers_rule", "model_ordinal", "receipt_scope", "planned_jobs", "workload", "workload_sha256"]
          }
        },
        "exact_workload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stage_receipt_count": {"const": 13},
            "independent_mixed_canary_jobs": {"const": 12},
            "per_model_ramp_jobs": {"const": 180},
            "total_record_slots": {"const": 192},
            "record_slots_per_model": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"const": 64}
            },
            "projected_cost_usd": {"const": 35.553},
            "projection_method": {"const": "historical_per_agent_cost_times_machine_counted_64_slots_over_100"}
          },
          "required": ["stage_receipt_count", "independent_mixed_canary_jobs", "per_model_ramp_jobs", "total_record_slots", "record_slots_per_model", "projected_cost_usd", "projection_method"]
        },
        "runtime_snapshot": {"type": "object", "minProperties": 1},
        "blind_only": {"const": true},
        "contains_evidence_or_labels": {"const": false}
      },
      "required": ["round_kind", "receipt_scope", "runtime_policy", "runtime_infra", "agents_config", "manifest", "source_bundle", "execution_budget_plan", "bridge", "result_namespace", "stage_order_algorithm", "stages", "exact_workload", "runtime_snapshot", "blind_only", "contains_evidence_or_labels"]
    }
  },
  "required": ["schema_version", "status", "created_at", "definition", "definition_sha256", "artifact_namespace"]
}
