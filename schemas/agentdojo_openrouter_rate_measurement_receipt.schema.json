{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_rate_measurement_receipt.schema.json",
  "title": "agentdojo_openrouter_rate_measurement_receipt",
  "description": "Recomputed, evidence-blind first-round exploratory OpenRouter rate measurement for all three frozen models.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"]
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "operational_definition_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256", "semantic_sha256", "operational_definition_sha256"]
    },
    "round_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "definition_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256", "definition_sha256"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measured_max_rolling_rpm": {"type": "integer", "minimum": 1},
        "measured_max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
        "measured_max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
        "maximum_validated_concurrency": {"enum": [4, 8, 16, 32]},
        "recommended_requests_per_minute": {"type": "integer", "minimum": 1},
        "recommended_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
        "recommended_concurrent_requests": {"enum": [4, 8, 16, 32]}
      },
      "required": ["measured_max_rolling_rpm", "measured_max_rolling_admission_reservation_units_per_minute", "measured_max_rolling_provider_actual_tokens_per_minute", "maximum_validated_concurrency", "recommended_requests_per_minute", "recommended_admission_reservation_units_per_minute", "recommended_concurrent_requests"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_rate_measurement_receipt/v1"},
    "status": {"const": "measured"},
    "created_at": {"type": "string", "format": "date-time"},
    "candidate_runtime_policy": {"$ref": "#/$defs/policy_ref"},
    "runtime_infra": {"$ref": "#/$defs/file_ref"},
    "base_agents_config": {"$ref": "#/$defs/file_ref"},
    "model_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "management_audit_fingerprint_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "management_audit_status": {"enum": ["waived_by_user", "performed"]},
    "pre_ramp_credential_receipt": {"$ref": "#/$defs/file_ref"},
    "measurement_round_plan": {"$ref": "#/$defs/round_plan_ref"},
    "global_mixed_canary_receipt": {"$ref": "#/$defs/file_ref"},
    "stage_receipts": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "worker_concurrency": {"enum": [4,8,16,32]}, "effective_workers": {"enum": [4,8,16,32]}, "model_ordinal": {"type": "integer", "minimum": 0, "maximum": 2}},
        "required": ["path", "sha256", "worker_concurrency", "effective_workers", "model_ordinal"]
      }
    },
    "global": {"$ref": "#/$defs/limits"},
    "per_model": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {"enum": ["Agent A", "Agent B", "Agent C"]},
          "model_id": {"enum": ["openai/gpt-5.4", "anthropic/claude-opus-4.7", "deepseek/deepseek-v4-pro"]},
          "model_config_sha256": {"$ref": "#/$defs/sha256"},
          "measured_max_rolling_rpm": {"type": "integer", "minimum": 1},
          "measured_max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
          "measured_max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
          "attempted_max_rolling_rpm": {"type": "integer", "minimum": 1},
          "attempted_max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
          "attempted_max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
          "maximum_validated_concurrency": {"enum": [4, 8, 16, 32]},
          "recommended_requests_per_minute": {"type": "integer", "minimum": 1},
          "recommended_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
          "recommended_concurrent_requests": {"enum": [4, 8, 16, 32]},
          "stage_outcomes": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "worker_concurrency": {"enum": [4, 8, 16, 32]},
                "effective_workers": {"enum": [4, 8, 16, 32]},
                "ran_at_locked_target": {"type": "boolean"},
                "status": {"enum": ["passed", "held_at_prior_safe", "measured_with_threshold_breach"]},
                "thresholds_passed": {"type": "boolean"},
                "achieved_successful_job_throughput_per_minute": {"type": "number", "minimum": 0},
                "achieved_admission_reservation_units_throughput_per_minute": {"type": "number", "exclusiveMinimum": 0}
              },
              "required": ["worker_concurrency", "effective_workers", "ran_at_locked_target", "status", "thresholds_passed", "achieved_successful_job_throughput_per_minute", "achieved_admission_reservation_units_throughput_per_minute"]
            }
          }
        },
        "required": ["agent_id", "model_id", "model_config_sha256", "measured_max_rolling_rpm", "measured_max_rolling_admission_reservation_units_per_minute", "measured_max_rolling_provider_actual_tokens_per_minute", "attempted_max_rolling_rpm", "attempted_max_rolling_admission_reservation_units_per_minute", "attempted_max_rolling_provider_actual_tokens_per_minute", "maximum_validated_concurrency", "recommended_requests_per_minute", "recommended_admission_reservation_units_per_minute", "recommended_concurrent_requests", "stage_outcomes"]
      }
    },
    "recommendation_algorithm": {"const": "floor_observed_admission_reservation_rate_times_0_80"},
    "recommendation_definition_sha256": {"$ref": "#/$defs/sha256"},
    "requested_exploratory_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {"type": "integer", "minimum": 300},
        "tokens_per_minute": {"type": "integer", "minimum": 1000000},
        "concurrent_requests": {"const": 32}
      },
      "required": ["requests_per_minute", "tokens_per_minute", "concurrent_requests"]
    },
    "provider_error_totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_429": {"type": "integer", "minimum": 0},
        "http_503": {"type": "integer", "minimum": 0},
        "http_429_openrouter_or_upstream_unspecified": {"type": "integer", "minimum": 0},
        "http_503_service_origin_unspecified": {"type": "integer", "minimum": 0},
        "transport_or_non_http": {"type": "integer", "minimum": 0}
      },
      "required": ["http_429", "http_503", "http_429_openrouter_or_upstream_unspecified", "http_503_service_origin_unspecified", "transport_or_non_http"]
    },
    "runtime_snapshot": {"type": "object"},
    "blind_only": {"const": true},
    "contains_prompt_response_trajectory_evaluator_or_label": {"const": false}
  },
  "required": ["schema_version", "status", "created_at", "candidate_runtime_policy", "runtime_infra", "base_agents_config", "model_catalog_sha256", "credential_fingerprint_sha256", "management_audit_fingerprint_sha256", "management_audit_status", "pre_ramp_credential_receipt", "measurement_round_plan", "global_mixed_canary_receipt", "stage_receipts", "global", "per_model", "recommendation_algorithm", "recommendation_definition_sha256", "requested_exploratory_envelope", "provider_error_totals", "runtime_snapshot", "blind_only", "contains_prompt_response_trajectory_evaluator_or_label"]
}
