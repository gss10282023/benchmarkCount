{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "artifact_retention_mode": {
      "description": "Optional immutable artifact-placement policy for VPS-resident formal evidence.",
      "enum": [
        "vps_persistent_remote_v1"
      ],
      "type": "string"
    },
    "adapter_module": {
      "$ref": "#/$defs/nonempty_string"
    },
    "agent_config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "artifact_contract": {
      "type": "object"
    },
    "attempt_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "benchmark_config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "benchmark_name": {
      "$ref": "#/$defs/nonempty_string"
    },
    "case_unit_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "deterministic_selection": {
      "$ref": "#/$defs/deterministic_selection"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "domain_display_name": {
      "$ref": "#/$defs/nonempty_string"
    },
    "evidence_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_contract_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "evidence_contract_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "execution_lock_path": {
      "$ref": "#/$defs/path"
    },
    "execution_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "force_rerun": {
      "type": "boolean"
    },
    "rerun_completed": {
      "type": "boolean"
    },
    "execution_target": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "const": 1
        },
        "controller_ssh_public_key_fingerprint": {
          "pattern": "^SHA256:[A-Za-z0-9+/=]+$",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/nonempty_string"
        },
        "server_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ssh_host": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ssh_host_ed25519_fingerprint": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ssh_user": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "server_id",
        "ssh_host",
        "ssh_user",
        "ssh_host_ed25519_fingerprint",
        "model",
        "concurrency"
      ],
      "type": "object"
    },
    "final_attempt": {
      "type": "boolean"
    },
    "formal_wall_clock_timeout_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "formal_policy_lock": {
      "additionalProperties": false,
      "description": "Optional benchmark-specific formal launch policy binding. WebArena-Verified machine-only waiver jobs require this block; its presence never represents human signoff.",
      "properties": {
        "basis": {
          "const": "operator_machine_only_waiver"
        },
        "case_packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "human_signoff_claimed": {
          "const": false
        },
        "human_signed_count": {
          "const": 0
        },
        "locked_contract_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "$ref": "#/$defs/nonempty_string"
        },
        "native_claim_acceptance_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_claim_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operator_waiver_path": {
          "$ref": "#/$defs/path"
        },
        "operator_waiver_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reset_policy": {
          "const": "recreate_task_sites_from_digest_v1"
        },
        "schema_version": {
          "const": "webarena_verified_job_formal_policy_lock/v1"
        },
        "server_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "step19_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "basis",
        "operator_waiver_path",
        "operator_waiver_sha256",
        "human_signoff_claimed",
        "human_signed_count",
        "step19_manifest_sha256",
        "source_bundle_sha256",
        "native_claim_index_sha256",
        "native_claim_acceptance_sha256",
        "case_packet_sha256",
        "locked_contract_file_sha256",
        "model",
        "server_id",
        "reset_policy"
      ],
      "type": "object"
    },
    "job_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "openrouter_runtime_policy": {
      "type": "object"
    },
    "openrouter_runtime_policy_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "openrouter_runtime_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "pilot_within_task_order": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "requested_model": {
      "$ref": "#/$defs/nonempty_string"
    },
    "reset_policy": {
      "const": "recreate_task_sites_from_digest_v1"
    },
    "reset_receipt_relative_path": {
      "const": "reset_receipt.json"
    },
    "record_slot_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "result_namespace": {
      "description": "Optional isolated result run-set; jobs without it retain the legacy results/<phase>/<domain>/<job_id> path.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "schema_version": {
      "const": "job/v1"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "task_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "task_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "task_sites": {
      "items": {
        "enum": [
          "shopping",
          "shopping_admin",
          "reddit",
          "gitlab",
          "wikipedia",
          "map"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "taxonomy_version": {
      "$ref": "#/$defs/nonempty_string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "domain",
    "domain_display_name",
    "benchmark_name",
    "case_unit_id",
    "task_id",
    "record_slot_id",
    "run_id",
    "attempt_id",
    "final_attempt",
    "seed",
    "agent_id",
    "phase",
    "experiment_type",
    "priority",
    "adapter_module",
    "agent_config_hash",
    "benchmark_config_hash",
    "manifest_hash",
    "evidence_contract_id",
    "evidence_contract_hash",
    "contract_id",
    "contract_version",
    "contract_hash",
    "taxonomy_version",
    "artifact_contract",
    "deterministic_selection",
    "evidence_contract_version"
  ],
  "title": "job",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
