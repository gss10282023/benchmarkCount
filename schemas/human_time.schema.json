{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/human_time.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "action": {
      "$ref": "#/$defs/nonempty_string"
    },
    "activity_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "activity_type": {
      "enum": [
        "contract_draft_review",
        "contract_lock",
        "evidence_scoring_review",
        "unresolve_tagging",
        "audit",
        "rerun_review",
        "setup",
        "release_review"
      ],
      "type": "string"
    },
    "case_unit_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "contract_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "counts_for_cost_table": {
      "type": "boolean"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "duration_minutes": {
      "minimum": 0,
      "type": "number"
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "no_benchmark_execution_compute_included": {
      "const": true
    },
    "no_cloud_bill_included": {
      "const": true
    },
    "no_llm_cost_included": {
      "const": true
    },
    "no_local_machine_runtime_included": {
      "const": true
    },
    "no_vps_cost_included": {
      "const": true
    },
    "notes": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "record_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer_or_worker_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "role": {
      "enum": [
        "adapter_author",
        "auditor",
        "scorer_reviewer",
        "release_reviewer",
        "other"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "human_time/v1"
    },
    "source_artifacts": {
      "items": {
        "$ref": "#/$defs/path"
      },
      "type": "array"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "required": [
    "schema_version",
    "activity_id",
    "reviewer_or_worker_id",
    "role",
    "activity_type",
    "started_at",
    "finished_at",
    "duration_minutes",
    "action",
    "source_artifacts",
    "phase",
    "experiment_type",
    "priority",
    "manifest_hash",
    "counts_for_cost_table",
    "no_llm_cost_included",
    "no_vps_cost_included",
    "no_cloud_bill_included",
    "no_benchmark_execution_compute_included",
    "no_local_machine_runtime_included"
  ],
  "title": "human_time",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
