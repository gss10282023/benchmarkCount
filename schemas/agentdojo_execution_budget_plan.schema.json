{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_execution_budget_plan.schema.json",
  "title": "agentdojo_execution_budget_plan",
  "description": "Metadata-only 100-case observation and 949-case AgentDojo execution budget projection.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_slots": {"type": "integer", "minimum": 1},
        "calls": {"type": "integer", "minimum": 1},
        "prompt_tokens": {"type": "integer", "minimum": 1},
        "completion_tokens": {"type": "integer", "minimum": 1},
        "total_tokens": {"type": "integer", "minimum": 1},
        "cost_usd": {"type": "number", "minimum": 0}
      },
      "required": ["record_slots", "calls", "prompt_tokens", "completion_tokens", "total_tokens", "cost_usd"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_slots": {"const": 949},
        "calls": {"type": "integer", "minimum": 1},
        "prompt_tokens": {"type": "integer", "minimum": 1},
        "completion_tokens": {"type": "integer", "minimum": 1},
        "total_tokens": {"type": "integer", "minimum": 1},
        "cost_usd_unrounded": {"type": "number", "minimum": 0}
      },
      "required": ["record_slots", "calls", "prompt_tokens", "completion_tokens", "total_tokens", "cost_usd_unrounded"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_execution_budget_plan/v1"},
    "plan_id": {"const": "agentdojo_full_v1.2.2_direct_execution_budget"},
    "status": {"const": "locked"},
    "created_at": {"type": "string", "format": "date-time"},
    "definition_sha256": {"$ref": "#/$defs/sha256"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "historical_observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_units": {"const": 100},
            "record_slots": {"const": 300},
            "agents": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Agent A": {"$ref": "#/$defs/accounting"},
                "Agent B": {"$ref": "#/$defs/accounting"},
                "Agent C": {"$ref": "#/$defs/accounting"}
              },
              "required": ["Agent A", "Agent B", "Agent C"]
            },
            "total": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "calls": {"type": "integer", "minimum": 1},
                "prompt_tokens": {"type": "integer", "minimum": 1},
                "completion_tokens": {"type": "integer", "minimum": 1},
                "total_tokens": {"type": "integer", "minimum": 1},
                "cost_usd": {"type": "number", "minimum": 0}
              },
              "required": ["calls", "prompt_tokens", "completion_tokens", "total_tokens", "cost_usd"]
            }
          },
          "required": ["case_units", "record_slots", "agents", "total"]
        },
        "full_projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_units": {"const": 949},
            "record_slots": {"const": 2847},
            "agents": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Agent A": {"$ref": "#/$defs/projection"},
                "Agent B": {"$ref": "#/$defs/projection"},
                "Agent C": {"$ref": "#/$defs/projection"}
              },
              "required": ["Agent A", "Agent B", "Agent C"]
            },
            "total": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "calls": {"type": "integer", "minimum": 1},
                "prompt_tokens": {"type": "integer", "minimum": 1},
                "completion_tokens": {"type": "integer", "minimum": 1},
                "total_tokens": {"type": "integer", "minimum": 1},
                "cost_usd_unrounded": {"type": "number", "minimum": 0},
                "cost_usd": {"const": 527.18}
              },
              "required": ["calls", "prompt_tokens", "completion_tokens", "total_tokens", "cost_usd_unrounded", "cost_usd"]
            }
          },
          "required": ["case_units", "record_slots", "agents", "total"]
        },
        "budget_guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projected_cost_usd": {"const": 527.18},
            "credit_floor_usd": {"const": 650.0},
            "maximum_run_cost_usd": {"const": 650.0},
            "headroom_usd": {"const": 122.82},
            "cost_cap_action": {"const": "block_new_requests"}
          },
          "required": ["projected_cost_usd", "credit_floor_usd", "maximum_run_cost_usd", "headroom_usd", "cost_cap_action"]
        },
        "preflight_projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concurrency_stages_per_agent": {
              "type": "array",
              "prefixItems": [
                {"const": 4},
                {"const": 8},
                {"const": 16},
                {"const": 32}
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "model_concurrency_substage_count_per_round": {"const": 12},
            "stage_receipt_count_per_round": {"const": 13},
            "per_model_ramp_slots_per_agent_per_round": {"const": 60},
            "independent_mixed_canary_slots_per_agent_per_round": {"const": 4},
            "independent_mixed_canary_record_slots_per_round": {"const": 12},
            "slots_per_agent_per_round": {"const": 64},
            "record_slots_per_round": {"const": 192},
            "rounds": {
              "type": "array",
              "prefixItems": [
                {"const": "measurement"},
                {"const": "final_hash_validation"}
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "round_count": {"const": 2},
            "agent_cost_usd_per_round": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Agent A": {"const": 2.391},
                "Agent B": {"const": 30.809},
                "Agent C": {"const": 2.352}
              },
              "required": ["Agent A", "Agent B", "Agent C"]
            },
            "cost_usd_per_round": {"const": 35.553},
            "two_round_cost_usd": {"const": 71.106},
            "credential_and_mixed_canary_margin_usd": {"const": 78.894},
            "preflight_reserve_usd": {"const": 150.0},
            "recommended_initial_credit_usd": {"const": 800.0},
            "required_post_ramp_credit_usd": {"const": 650.0},
            "formal_maximum_run_cost_usd": {"const": 650.0},
            "credit_gate": {"const": "require_initial_credit_at_least_800_and_after_disposable_ramp_require_remaining_credit_at_least_650"}
          },
          "required": ["concurrency_stages_per_agent", "model_concurrency_substage_count_per_round", "stage_receipt_count_per_round", "per_model_ramp_slots_per_agent_per_round", "independent_mixed_canary_slots_per_agent_per_round", "independent_mixed_canary_record_slots_per_round", "slots_per_agent_per_round", "record_slots_per_round", "rounds", "round_count", "agent_cost_usd_per_round", "cost_usd_per_round", "two_round_cost_usd", "credential_and_mixed_canary_margin_usd", "preflight_reserve_usd", "recommended_initial_credit_usd", "required_post_ramp_credit_usd", "formal_maximum_run_cost_usd", "credit_gate"]
        },
        "methodology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"const": "case_linear_extrapolation_from_existing_100_case_run"},
            "factor_numerator": {"const": 949},
            "factor_denominator": {"const": 100},
            "factor": {"const": 9.49},
            "calls_and_tokens_rounding": {"const": "ceiling_per_agent"},
            "cost_rounding": {"const": "provider_reported_cost_scaled_then_half_up_to_usd_cent"},
            "assumption": {"$ref": "#/$defs/nonempty"}
          },
          "required": ["method", "factor_numerator", "factor_denominator", "factor", "calls_and_tokens_rounding", "cost_rounding", "assumption"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "#/$defs/nonempty"},
            "scope": {"$ref": "#/$defs/nonempty"},
            "calls_log_file_count": {"const": 300},
            "calls_log_set_sha256": {"$ref": "#/$defs/sha256"},
            "source_tree_sha256": {"$ref": "#/$defs/sha256"},
            "response_content_included": {"const": false},
            "prompt_content_included": {"const": false},
            "trajectory_content_included": {"const": false},
            "evaluator_labels_included": {"const": false},
            "secret_material_included": {"const": false}
          },
          "required": ["path", "scope", "calls_log_file_count", "calls_log_set_sha256", "source_tree_sha256", "response_content_included", "prompt_content_included", "trajectory_content_included", "evaluator_labels_included", "secret_material_included"]
        }
      },
      "required": ["historical_observation", "full_projection", "budget_guard", "preflight_projection", "methodology", "source"]
    }
  },
  "required": ["schema_version", "plan_id", "status", "created_at", "definition", "definition_sha256"]
}
