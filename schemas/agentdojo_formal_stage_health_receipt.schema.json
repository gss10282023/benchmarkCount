{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_formal_stage_health_receipt.schema.json",
  "title": "agentdojo_formal_stage_health_receipt",
  "description": "Evidence-blind, session-bound health decision for one formal AgentDojo stage; threshold failures produce a valid hold/downgrade decision.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "agent_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {"enum": ["Agent A", "Agent B", "Agent C"]},
        "model_id": {"enum": ["openai/gpt-5.4", "anthropic/claude-opus-4.7", "deepseek/deepseek-v4-pro"]},
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "record_slot_count": {"type": "integer", "minimum": 0}
      },
      "required": ["agent_id", "model_id", "model_config_sha256", "record_slot_count"]
    },
    "request_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_chain_count": {"type": "integer", "minimum": 0},
        "unresolved_request_chain_count": {"type": "integer", "minimum": 0},
        "recovered_429_503_chain_count": {"type": "integer", "minimum": 0},
        "recovered_429_503_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_consecutive_429_503": {"type": "integer", "minimum": 0},
        "max_retry_delay_seconds_per_chain": {"type": "number", "minimum": 0},
        "max_rolling_rpm": {"type": "integer", "minimum": 0},
        "max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 0},
        "max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
        "thresholds_passed": {"type": "boolean"}
      },
      "required": ["request_chain_count", "unresolved_request_chain_count", "recovered_429_503_chain_count", "recovered_429_503_fraction", "max_consecutive_429_503", "max_retry_delay_seconds_per_chain", "max_rolling_rpm", "max_rolling_admission_reservation_units_per_minute", "max_rolling_provider_actual_tokens_per_minute", "thresholds_passed"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_formal_stage_health_receipt/v1"},
    "status": {"enum": ["passed_health_gate", "valid_hold_or_downgrade"]},
    "created_at": {"type": "string", "format": "date-time"},
    "stage_workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_formal_stage_health_workload/v1"},
        "execution_lock_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "plan_index_sha256": {"$ref": "#/$defs/sha256"},
        "stage_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "workers": {"enum": [4, 8, 16, 32]},
        "record_slot_count": {"type": "integer", "minimum": 1},
        "record_slot_ids_sha256": {"$ref": "#/$defs/sha256"},
        "target_agent_id": {"type": ["string", "null"]},
        "agent_models": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/agent_model"}}
      },
      "required": ["schema_version", "execution_lock_sha256", "execution_policy_sha256", "plan_index_sha256", "stage_id", "workers", "record_slot_count", "record_slot_ids_sha256", "target_agent_id", "agent_models"]
    },
    "stage_workload_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_policy_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_policy": {"type": "object"},
    "runtime_infra_file_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_snapshot": {"type": "object"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "pattern": "^session-[a-z0-9_-]+$"},
        "host_boot_id": {"type": "string", "pattern": "^[a-f0-9-]{32,36}$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      },
      "required": ["session_id", "host_boot_id", "started_at", "ended_at"]
    },
    "blind_health_ledger": {"$ref": "#/$defs/file_ref"},
    "resource_ledger": {"$ref": "#/$defs/file_ref"},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health_record_count": {"type": "integer", "minimum": 0},
        "resource_sample_count": {"type": "integer", "minimum": 0},
        "request_attempt_count": {"type": "integer", "minimum": 0},
        "worker_completion_count": {"type": "integer", "minimum": 0},
        "max_cpu_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "max_memory_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "max_swap_used_bytes": {"type": "integer", "minimum": 0},
        "max_active_worker_processes": {"type": "integer", "minimum": 0},
        "max_active_openrouter_leases": {"type": "integer", "minimum": 0},
        "minimum_required_active_worker_processes": {"type": "integer", "minimum": 1},
        "minimum_required_active_openrouter_leases": {"type": "integer", "minimum": 1},
        "resource_thresholds_passed": {"type": "boolean"}
      },
      "required": ["health_record_count", "resource_sample_count", "request_attempt_count", "worker_completion_count", "max_cpu_percent", "max_memory_percent", "max_swap_used_bytes", "max_active_worker_processes", "max_active_openrouter_leases", "minimum_required_active_worker_processes", "minimum_required_active_openrouter_leases", "resource_thresholds_passed"]
    },
    "model_decisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {"enum": ["Agent A", "Agent B", "Agent C"]},
          "model_id": {"enum": ["openai/gpt-5.4", "anthropic/claude-opus-4.7", "deepseek/deepseek-v4-pro"]},
          "model_config_sha256": {"$ref": "#/$defs/sha256"},
          "record_slot_count": {"type": "integer", "minimum": 0},
          "request_attempt_count": {"type": "integer", "minimum": 0},
          "successful_worker_completion_count": {"type": "integer", "minimum": 0},
          "worker_failure_count": {"type": "integer", "minimum": 0},
          "promotion_authorized": {"type": "boolean"},
          "safe_workers": {"enum": [4, 8, 16, 32]},
          "request_health": {"$ref": "#/$defs/request_health"}
        },
        "required": ["agent_id", "model_id", "model_config_sha256", "record_slot_count", "request_attempt_count", "successful_worker_completion_count", "worker_failure_count", "promotion_authorized", "safe_workers", "request_health"]
      }
    },
    "promotion_authorized": {"type": "boolean"},
    "safe_workers": {"enum": [4, 8, 16, 32]},
    "prior_safe_workers": {"enum": [4, 8, 16, 32]},
    "blind_only": {"const": true},
    "contains_case_agent_prompt_response_trajectory_evaluator_or_label": {"const": false}
  },
  "required": ["schema_version", "status", "created_at", "stage_workload", "stage_workload_sha256", "runtime_policy_semantic_sha256", "runtime_policy", "runtime_infra_file_sha256", "runtime_snapshot", "session", "blind_health_ledger", "resource_ledger", "observed", "model_decisions", "promotion_authorized", "safe_workers", "prior_safe_workers", "blind_only", "contains_case_agent_prompt_response_trajectory_evaluator_or_label"]
}
