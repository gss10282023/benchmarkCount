{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_final_runtime_deployment_receipt.schema.json",
  "title": "agentdojo_final_runtime_deployment_receipt",
  "description": "Final pre-lock exact-delete runtime deployment and local/remote hash-equivalence receipt.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_lock": {
      "type": "object", "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"]
    },
    "tree": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_method": {"const": "relative_posix_path_nul_sha256_bytes/v1"},
        "excluded_patterns": {
          "type": "array",
          "prefixItems": [{"const": "**/__pycache__/**"}, {"const": "**/*.pyc"}, {"const": "**/*.pyo"}],
          "minItems": 3, "maxItems": 3
        }
      },
      "required": ["root", "file_count", "tree_sha256", "normalization_method", "excluded_patterns"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_final_runtime_deployment_receipt/v1"},
    "status": {"const": "synced_verified_frozen"},
    "completed_at": {"type": "string", "format": "date-time"},
    "runtime_infra": {"$ref": "#/$defs/path_lock"},
    "runtime_snapshot": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_execution_runtime_snapshot/v1"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "files", "aggregate_sha256"]
    },
    "remote_runtime_snapshot": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_execution_runtime_snapshot/v1"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "files", "aggregate_sha256"]
    },
    "runtime_snapshots_equal": {"const": true},
    "local_source": {"$ref": "#/$defs/tree"},
    "remote_source": {"$ref": "#/$defs/tree"},
    "trees_equal": {"const": true},
    "rsync_delete": {"const": true},
    "rsync_source_trailing_slash": {"const": true},
    "remote_extra_file_count": {"const": 0},
    "sync_completed_before_namespace_init": {"const": true},
    "namespace_uninitialized_at_completion": {"const": true},
    "runtime_mutation_after_init_forbidden": {"const": true},
    "secrets_included": {"const": false}
  },
  "required": ["schema_version", "status", "completed_at", "runtime_infra", "runtime_snapshot", "remote_runtime_snapshot", "runtime_snapshots_equal", "local_source", "remote_source", "trees_equal", "rsync_delete", "rsync_source_trailing_slash", "remote_extra_file_count", "sync_completed_before_namespace_init", "namespace_uninitialized_at_completion", "runtime_mutation_after_init_forbidden", "secrets_included"]
}
