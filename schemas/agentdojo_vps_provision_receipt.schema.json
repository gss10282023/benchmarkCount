{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_vps_provision_receipt.schema.json",
  "title": "agentdojo_vps_provision_receipt",
  "description": "Content-free proof of the pinned AgentDojo full-run VPS identity, installation, resources, and security posture.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "source_closure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_runtime_source_closure/v1"},
        "package_name": {"const": "agentdojo"},
        "package_version": {"const": "0.1.35"},
        "official_git_commit": {"const": "a75aba7631d3ca5fb7ab938965c97ead2f9ff84b"},
        "official_git_tree": {"const": "3c74b60f2bad4ff321d864e0c0483f256cc8f8d2"},
        "wheel_filename": {"const": "agentdojo-0.1.35-py3-none-any.whl"},
        "wheel_sha256": {"const": "364bea4219716b716bf639f504d195943f7f6a5535d312ca41d7098704a2affd"},
        "wheel_file_path": {"type": "string", "pattern": "^/"},
        "dist_info_record_relative_path": {"type": "string", "pattern": "^[^/]+\\.dist-info/RECORD$"},
        "dist_info_record_sha256": {"$ref": "#/$defs/sha256"},
        "installed_file_count": {"type": "integer", "minimum": 1},
        "installed_path_set_sha256": {"$ref": "#/$defs/sha256"},
        "installed_content_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "record_entry_count": {"type": "integer", "minimum": 1},
        "record_verified_file_count": {"type": "integer", "minimum": 1},
        "record_unhashed_entry_count": {"type": "integer", "minimum": 1},
        "record_verification": {"const": "all_hashed_entries_match_paths_contained_no_links_or_special_inodes"},
        "imported_package_root": {"type": "string", "pattern": "^/"},
        "upstream_repository_root": {"type": "string", "pattern": "^/"},
        "upstream_head_matches_official_commit": {"const": true},
        "upstream_tree_matches_official_tree": {"const": true},
        "installed_source_matches_upstream_tree": {"const": true},
        "closure_verified": {"const": true},
        "secret_material_recorded": {"const": false}
      },
      "required": ["schema_version", "package_name", "package_version", "official_git_commit", "official_git_tree", "wheel_filename", "wheel_sha256", "wheel_file_path", "dist_info_record_relative_path", "dist_info_record_sha256", "installed_file_count", "installed_path_set_sha256", "installed_content_manifest_sha256", "record_entry_count", "record_verified_file_count", "record_unhashed_entry_count", "record_verification", "imported_package_root", "upstream_repository_root", "upstream_head_matches_official_commit", "upstream_tree_matches_official_tree", "installed_source_matches_upstream_tree", "closure_verified", "secret_material_recorded"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_vps_provision_receipt/v2"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["provisioned", "provisioned_blocked_on_credentials"]},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"$ref": "#/$defs/nonempty"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "user": {"$ref": "#/$defs/nonempty"}
      },
      "required": ["host", "port", "user"]
    },
    "host_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ssh-ed25519"},
        "fingerprint_sha256": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
        "local_known_hosts_match": {"const": true},
        "remote_public_key_match": {"const": true}
      },
      "required": ["algorithm", "fingerprint_sha256", "local_known_hosts_match", "remote_public_key_match"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_root": {"type": "string", "pattern": "^/"},
        "python": {"type": "string", "pattern": "^/"},
        "uv": {"type": "string", "pattern": "^/"},
        "agentdojo_upstream": {"type": "string", "pattern": "^/"}
      },
      "required": ["repo_root", "python", "uv", "agentdojo_upstream"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"const": "Vultr"},
        "hardware_model": {"$ref": "#/$defs/nonempty"},
        "hostname": {"$ref": "#/$defs/nonempty"},
        "os": {"$ref": "#/$defs/nonempty"},
        "kernel": {"$ref": "#/$defs/nonempty"},
        "architecture": {"const": "x86_64"},
        "cpu_model": {"$ref": "#/$defs/nonempty"},
        "vcpu_count": {"type": "integer", "minimum": 1},
        "memory_kib": {"type": "integer", "minimum": 1},
        "swap_bytes": {"type": "integer", "minimum": 0},
        "root_disk_bytes": {"type": "integer", "minimum": 1},
        "root_disk_available_bytes": {"type": "integer", "minimum": 1}
      },
      "required": ["provider", "hardware_model", "hostname", "os", "kernel", "architecture", "cpu_model", "vcpu_count", "memory_kib", "swap_bytes", "root_disk_bytes", "root_disk_available_bytes"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python_version": {"$ref": "#/$defs/nonempty"},
        "uv_version": {"$ref": "#/$defs/nonempty"},
        "install_command": {"const": "uv sync --locked --extra agentdojo-full"},
        "uv_lock_check": {"const": "passed"},
        "pyproject_sha256": {"$ref": "#/$defs/sha256"},
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"},
        "deployed_src_file_count": {"type": "integer", "minimum": 1},
        "deployed_src_tree_sha256": {"$ref": "#/$defs/sha256"},
        "deployed_src_tree_excludes": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty"},
          "minItems": 1,
          "uniqueItems": true
        },
        "local_remote_src_match_at_recording": {"const": true},
        "final_execution_freeze_resync_required": {"type": "boolean"}
      },
      "required": ["python_version", "uv_version", "install_command", "uv_lock_check", "pyproject_sha256", "uv_lock_sha256", "deployed_src_file_count", "deployed_src_tree_sha256", "deployed_src_tree_excludes", "local_remote_src_match_at_recording", "final_execution_freeze_resync_required"]
    },
    "agentdojo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_version": {"const": "0.1.35"},
        "git_tag": {"const": "v0.1.35"},
        "git_commit": {"const": "a75aba7631d3ca5fb7ab938965c97ead2f9ff84b"},
        "git_tree": {"const": "3c74b60f2bad4ff321d864e0c0483f256cc8f8d2"},
        "upstream_worktree_clean": {"const": true},
        "installed_source_matches_upstream_tree": {"const": true},
        "benchmark_version": {"const": "v1.2.2"},
        "suite_case_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "banking": {"const": 144},
            "slack": {"const": 105},
            "travel": {"const": 140},
            "workspace": {"const": 560}
          },
          "required": ["banking", "slack", "travel", "workspace"]
        },
        "case_count": {"const": 949}
      },
      "required": ["package_version", "git_tag", "git_commit", "git_tree", "upstream_worktree_clean", "installed_source_matches_upstream_tree", "benchmark_version", "suite_case_counts", "case_count"]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssh_root_login": {"const": false},
        "ssh_password_authentication": {"const": false},
        "ssh_keyboard_interactive_authentication": {"const": false},
        "ssh_public_key_authentication": {"const": true},
        "ssh_allow_users": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "minItems": 1, "uniqueItems": true},
        "ssh_max_sessions": {"type": "integer", "minimum": 32},
        "ssh_max_startups": {"$ref": "#/$defs/nonempty"},
        "nofile_limit": {"type": "integer", "minimum": 4096},
        "nproc_limit": {"type": "integer", "minimum": 4096},
        "ufw_active": {"const": true},
        "ufw_default_incoming": {"const": "deny"},
        "ufw_default_outgoing": {"const": "allow"},
        "ufw_allowed_inbound": {"type": "array", "items": {"const": "22/tcp"}, "minItems": 1, "maxItems": 1},
        "sshd_dropin_sha256": {"$ref": "#/$defs/sha256"},
        "limits_dropin_sha256": {"$ref": "#/$defs/sha256"},
        "sudoers_dropin_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["ssh_root_login", "ssh_password_authentication", "ssh_keyboard_interactive_authentication", "ssh_public_key_authentication", "ssh_allow_users", "ssh_max_sessions", "ssh_max_startups", "nofile_limit", "nproc_limit", "ufw_active", "ufw_default_incoming", "ufw_default_outgoing", "ufw_allowed_inbound", "sshd_dropin_sha256", "limits_dropin_sha256", "sudoers_dropin_sha256"]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openrouter_api_key_status": {"enum": ["missing", "validated"]},
        "openrouter_api_key_environment_present": {"type": "boolean"},
        "dotenv_file_count_under_runtime_root": {"const": 0},
        "openrouter_key_endpoint_check": {"enum": ["not_run_missing_credential", "passed"]},
        "secret_material_recorded": {"const": false}
      },
      "required": ["openrouter_api_key_status", "openrouter_api_key_environment_present", "dotenv_file_count_under_runtime_root", "openrouter_key_endpoint_check", "secret_material_recorded"]
    },
    "run_readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disposable_smoke_authorized": {"type": "boolean"},
        "formal_run_authorized": {"type": "boolean"},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["disposable_smoke_authorized", "formal_run_authorized", "blocking_reasons"]
    },
    "agentdojo_runtime_source_closure": {"$ref": "#/$defs/source_closure"},
    "agentdojo_runtime_source_closure_sha256": {"$ref": "#/$defs/sha256"},
    "preliminary_receipt_supersession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    }
  },
  "required": ["schema_version", "recorded_at_utc", "status", "endpoint", "host_identity", "paths", "platform", "runtime", "agentdojo", "security", "credentials", "run_readiness", "agentdojo_runtime_source_closure", "agentdojo_runtime_source_closure_sha256", "preliminary_receipt_supersession"]
}
