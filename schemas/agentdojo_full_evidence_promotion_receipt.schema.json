{
  "$id": "evidence_system/schemas/agentdojo_full_evidence_promotion_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentdojo_full_evidence_promotion_receipt",
  "description": "Byte-equivalence receipt for atomic AgentDojo staging-to-formal evidence promotion.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"]
    },
    "tree_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1}
      },
      "required": ["path", "tree_sha256", "file_count"]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": {"$ref": "#/$defs/path"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "destination_sha256": {"$ref": "#/$defs/sha256"},
        "transfer_method": {"type": "string", "enum": ["copy", "existing_verified"]}
      },
      "required": ["relative_path", "size_bytes", "source_sha256", "destination_sha256", "transfer_method"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_full_evidence_promotion_receipt/v1"},
    "promotion_id": {"const": "agentdojo_full_v1.2.2_direct_staging_to_formal"},
    "status": {"const": "promoted_and_verified"},
    "locked_at": {"type": "string", "minLength": 1},
    "result_namespace": {"const": "agentdojo_full_v1.2.2_direct"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_lock": {"$ref": "#/$defs/path_lock"},
        "checklist_freeze_lock": {"$ref": "#/$defs/path_lock"},
        "review_quiescence_receipt": {"$ref": "#/$defs/path_lock"},
        "sealed_retrieval_receipt": {"$ref": "#/$defs/path_lock"},
        "evidence_acceptance_index": {"$ref": "#/$defs/path_lock"},
        "namespace_reservation": {"$ref": "#/$defs/path_lock"},
        "source": {"$ref": "#/$defs/tree_lock"},
        "destination": {"$ref": "#/$defs/tree_lock"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cases": {"const": 949},
            "record_slots": {"const": 2847},
            "files": {"type": "integer", "minimum": 1},
            "hash_mismatches": {"const": 0}
          },
          "required": ["cases", "record_slots", "files", "hash_mismatches"]
        },
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "byte_preserving": {"const": true},
        "formal_tree_read_only": {"const": true},
        "formal_tree_hardlink_count": {"const": 0},
        "score_output_precondition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roots": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {"$ref": "#/$defs/path"},
                  "file_count": {"const": 0}
                },
                "required": ["path", "file_count"]
              }
            },
            "all_empty": {"const": true}
          },
          "required": ["roots", "all_empty"]
        },
        "publication": {"const": "atomic_directory_rename_after_full_hash_verification"},
        "publication_guarantees": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copy_only": {"const": true},
            "same_filesystem": {"const": true},
            "fsync_completed_before_publication": {"const": true},
            "atomic_rename_noreplace": {"const": true},
            "destination_overwrite_permitted": {"const": false}
          },
          "required": ["copy_only", "same_filesystem", "fsync_completed_before_publication", "atomic_rename_noreplace", "destination_overwrite_permitted"]
        }
      },
      "required": ["execution_lock", "checklist_freeze_lock", "review_quiescence_receipt", "sealed_retrieval_receipt", "evidence_acceptance_index", "namespace_reservation", "source", "destination", "counts", "inventory_sha256", "files", "byte_preserving", "formal_tree_read_only", "formal_tree_hardlink_count", "score_output_precondition", "publication", "publication_guarantees"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "promotion_id", "status", "locked_at", "result_namespace", "definition", "definition_sha256"],
  "x-step": "Step 3 Schema / Provenance / Validator"
}
