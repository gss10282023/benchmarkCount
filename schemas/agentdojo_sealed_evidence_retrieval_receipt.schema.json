{
  "$id": "evidence_system/schemas/agentdojo_sealed_evidence_retrieval_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentdojo_sealed_evidence_retrieval_receipt",
  "description": "Immutable content-blind receipt for checklist-gated retrieval of the complete sealed AgentDojo evidence tree.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_sealed_evidence_retrieval_receipt/v1"},
    "status": {"const": "retrieved_verified_atomic"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_lock": {"$ref": "#/$defs/path_lock"},
        "namespace_init_receipt": {"$ref": "#/$defs/path_lock"},
        "checklist_freeze_lock": {"$ref": "#/$defs/path_lock"},
        "review_quiescence_receipt": {"$ref": "#/$defs/path_lock"},
        "formal_completion_receipt": {"$ref": "#/$defs/path_lock"},
        "remote_completion_index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "entry_count": {"const": 2847},
            "entries_sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["path", "sha256", "entry_count", "entries_sha256"]
        },
        "controller_remote_snapshot_receipt": {"$ref": "#/$defs/path_lock"},
        "remote_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receipt_sha256": {"$ref": "#/$defs/sha256"},
            "snapshot_id": {"$ref": "#/$defs/sha256"},
            "archive_sha256": {"$ref": "#/$defs/sha256"},
            "archive_size_bytes": {"type": "integer", "minimum": 1},
            "source_tree_sha256": {"$ref": "#/$defs/sha256"},
            "source_file_count": {"type": "integer", "minimum": 2851},
            "source_total_bytes": {"type": "integer", "minimum": 1},
            "source_raw_file_count": {"type": "integer", "minimum": 2847},
            "source_blind_metadata_file_count": {"const": 4},
            "blind_metadata_entries_sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["receipt_sha256", "snapshot_id", "archive_sha256", "archive_size_bytes", "source_tree_sha256", "source_file_count", "source_total_bytes", "source_raw_file_count", "source_blind_metadata_file_count", "blind_metadata_entries_sha256"]
        },
        "ssh_transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "user": {"type": "string", "minLength": 1},
            "host_key_algorithm": {"const": "ssh-ed25519"},
            "host_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$"},
            "known_hosts": {"$ref": "#/$defs/path_lock"},
            "strict_host_key_checking": {"const": true},
            "password_authentication": {"const": false},
            "agent_forwarding": {"const": false}
          },
          "required": ["host", "port", "user", "host_key_algorithm", "host_fingerprint", "known_hosts", "strict_host_key_checking", "password_authentication", "agent_forwarding"]
        },
        "retrieval_controller": {"$ref": "#/$defs/path_lock"},
        "remote_raw_root": {"type": "string", "pattern": "^/", "minLength": 2},
        "remote_blind_root": {"type": "string", "pattern": "^/", "minLength": 2},
        "local_staging_root": {"$ref": "#/$defs/path"},
        "local_inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "file_count": {"type": "integer", "minimum": 1},
            "total_bytes": {"type": "integer", "minimum": 1}
          },
          "required": ["tree_sha256", "file_count", "total_bytes"]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cases": {"const": 949},
            "record_slots": {"const": 2847},
            "native_trajectories": {"const": 8541},
            "missing": {"const": 0},
            "duplicate": {"const": 0},
            "extra": {"const": 0},
            "hash_mismatch": {"const": 0}
          },
          "required": ["cases", "record_slots", "native_trajectories", "missing", "duplicate", "extra", "hash_mismatch"]
        },
        "transfer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temporary_root": {"$ref": "#/$defs/path"},
            "atomic_rename": {"const": true},
            "destination_previously_absent": {"const": true},
            "symlink_count": {"const": 0},
            "hardlink_count": {"const": 0},
            "path_escape_count": {"const": 0}
            ,"transport": {"const": "rsync_single_hash_locked_tar_over_strict_ed25519"}
            ,"rsync_delete_used": {"const": false}
            ,"remote_inventory_verified_before_transfer": {"const": true}
            ,"remote_pre_archive_post_inventory_identical": {"const": true}
            ,"archive_hash_verified_before_extraction": {"const": true}
            ,"regular_file_only_manual_extraction": {"const": true}
            ,"fsync_completed_before_publication": {"const": true}
            ,"rename_noreplace": {"const": true}
            ,"binding_to_job_id_mapping_sha256": {"$ref": "#/$defs/sha256"}
            ,"failed_attempt_archive_included": {"const": false}
          },
          "required": ["temporary_root", "atomic_rename", "destination_previously_absent", "symlink_count", "hardlink_count", "path_escape_count", "transport", "rsync_delete_used", "remote_inventory_verified_before_transfer", "remote_pre_archive_post_inventory_identical", "archive_hash_verified_before_extraction", "regular_file_only_manual_extraction", "fsync_completed_before_publication", "rename_noreplace", "binding_to_job_id_mapping_sha256", "failed_attempt_archive_included"]
        }
      },
      "required": ["execution_lock", "namespace_init_receipt", "checklist_freeze_lock", "review_quiescence_receipt", "formal_completion_receipt", "remote_completion_index", "controller_remote_snapshot_receipt", "remote_snapshot", "ssh_transport", "retrieval_controller", "remote_raw_root", "remote_blind_root", "local_staging_root", "local_inventory", "counts", "transfer"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "status", "retrieved_at", "definition", "definition_sha256"],
  "x-step": "Step 3 Schema / Provenance / Validator"
}
