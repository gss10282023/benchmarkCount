{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_credential_probe_receipt.schema.json",
  "title": "agentdojo_openrouter_credential_probe_receipt",
  "description": "Fail-closed, content-free receipt proving OpenRouter credentials, credit floor, model availability, runtime policy, and runtime infrastructure before AgentDojo execution.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agentdojo_openrouter_credential_probe_receipt/v1"
    },
    "status": {
      "const": "passed"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "probe_phase": {
      "enum": ["pre_ramp", "pre_final_validation", "post_ramp"]
    },
    "http_status": {
      "const": 200
    },
    "secret_material_recorded": {
      "const": false
    },
    "response_body_recorded": {
      "const": false
    },
    "credential_fingerprint_algorithm": {
      "const": "sha256(agentdojo-openrouter-key/v1\\0 || utf8_key_bytes)"
    },
    "credential_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "management_audit_fingerprint_algorithm": {
      "enum": ["sha256(agentdojo-openrouter-management-audit-key/v1\\0 || utf8_key_bytes)", null]
    },
    "management_audit_fingerprint_sha256": {
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    },
    "management_key_identity_sha256": {
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    },
    "management_audit_status": {
      "enum": ["waived_by_user", "performed"]
    },
    "management_audit_waiver_reason": {
      "enum": ["waived_by_user_execution_key_only", null]
    },
    "round_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["path", "sha256", "definition_sha256"]
    },
    "runtime_policy_semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_infra_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_limit_mode": {
      "enum": ["explicit_cap", "unlimited_no_provider_cap"]
    },
    "key_limit_usd": {
      "type": ["number", "null"],
      "minimum": 650.0
    },
    "key_limit_remaining_usd": {
      "type": ["number", "null"],
      "minimum": 650.0
    },
    "key_usage_usd": {
      "type": "number",
      "minimum": 0
    },
    "key_limit_remaining_floor_usd": {
      "enum": [650.0, 720.0, 800.0, null]
    },
    "key_limit_remaining_floor_formula": {
      "enum": [
        "minimum_preflight_start_credit_usd",
        "minimum_formal_start_remaining_usd + maximum_final_validation_cost_usd",
        "minimum_formal_start_remaining_usd",
        null
      ]
    },
    "credit_floor_proof_status": {
      "enum": [
        "verified_from_provider_key_cap",
        "waived_by_user_provider_balance_unavailable"
      ]
    },
    "credit_floor_waiver_reason": {
      "enum": [
        "provider_unlimited_key_exposes_no_limit_remaining_balance",
        null
      ]
    },
    "local_software_run_cost_cap_usd": {"const": 650.0},
    "local_software_cost_cap_action": {"const": "block_new_requests"},
    "budget_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_preflight_start_credit_usd": {"const": 800.0},
        "minimum_formal_start_remaining_usd": {"const": 650.0},
        "maximum_preflight_cost_usd": {"const": 120.0},
        "maximum_final_validation_cost_usd": {"const": 70.0},
        "maximum_formal_run_cost_usd": {"const": 650.0}
      },
      "required": [
        "minimum_preflight_start_credit_usd",
        "minimum_formal_start_remaining_usd",
        "maximum_preflight_cost_usd",
        "maximum_final_validation_cost_usd",
        "maximum_formal_run_cost_usd"
      ]
    },
    "budget_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_is_free_tier": {
      "const": false
    },
    "key_is_management": {
      "const": false
    },
    "key_is_provisioning": {
      "const": false
    },
    "key_disabled": {
      "type": ["boolean", "null"]
    },
    "key_disabled_field_present": {
      "type": "boolean"
    },
    "key_limit_reset_policy": {
      "const": null
    },
    "key_expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deprecated_rate_limit_used": {
      "const": false
    },
    "account_total_funding_independently_observable": {
      "type": "boolean"
    },
    "funding_semantics": {
      "enum": [
        "execution_key_cap_plus_management_key_account_credits/v1",
        "execution_key_limit_only_user_waiver/v1"
      ]
    },
    "account_balance_endpoint": {"enum": ["GET /api/v1/credits", null]},
    "account_total_credits_usd": {"type": ["number", "null"], "minimum": 0},
    "account_total_usage_usd": {"type": ["number", "null"], "minimum": 0},
    "account_remaining_usd": {"type": ["number", "null"], "minimum": 650},
    "account_remaining_floor_usd": {"enum": [650.0, 720.0, 800.0, null]},
    "account_balance_verified": {"type": "boolean"},
    "management_key_is_management": {"type": ["boolean", "null"]},
    "management_key_is_provisioning": {"type": ["boolean", "null"]},
    "management_key_disabled": {"type": ["boolean", "null"]},
    "management_key_local_probe_only": {"const": true},
    "management_key_deployed_to_vps": {"const": false},
    "same_account_inventory_proof": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_openrouter_same_account_inventory_proof/v1"},
        "method": {"const": "management_get_keys_inventory_unique_projection_match/v1"},
        "endpoint": {"const": "GET /api/v1/keys?offset={offset}&include_disabled=true"},
        "default_workspace_required": {"const": true},
        "default_workspace_unique_match_verified": {"const": true},
        "include_disabled": {"const": true},
        "page_size": {"const": 100},
        "hard_page_limit": {"const": 100},
        "pagination_termination": {"const": "offset_plus_equals_len_page_until_len_page_lt_100"},
        "repeated_page_detection": {"const": true},
        "page_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "inventory_entry_count": {"type": "integer", "minimum": 1, "maximum": 9999},
        "page_receipts": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "offset": {"type": "integer", "minimum": 0},
              "count": {"type": "integer", "minimum": 0, "maximum": 100},
              "canonical_response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "required": ["offset", "count", "canonical_response_sha256"]
          }
        },
        "match_fields": {
          "type": "array",
          "prefixItems": [
            {"const": "creator_user_id"}, {"const": "label"},
            {"const": "limit"}, {"const": "limit_remaining"},
            {"const": "limit_reset"}, {"const": "usage"},
            {"const": "expires_at"}
          ],
          "items": false, "minItems": 7, "maxItems": 7
        },
        "float_match_tolerance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "absolute": {"const": 1e-9},
            "relative": {"const": 1e-12}
          },
          "required": ["absolute", "relative"]
        },
        "execution_key_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "matched_inventory_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "unique_match_count": {"const": 1},
        "match_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_or_raw_key_hash_comparison_used": {"const": false},
        "inventory_rows_labels_or_provider_key_hashes_recorded": {"const": false},
        "critical_section": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "controller_lifecycle_lock_path": {"type": "string", "minLength": 1},
            "lock_mode": {"const": "exclusive"},
            "covers_execution_key_inventory_credits_and_catalog_queries": {"const": true},
            "controller_stage_launch_and_supervisor_lifecycle_blocked": {"const": true},
            "remote_inference_blocked_by_controller_flock": {"const": false},
            "remote_quiescence_receipts_required": {"const": true},
            "execution_usage_quiescence_requires_bound_remote_receipts": {"const": true}
          },
          "required": [
            "controller_lifecycle_lock_path", "lock_mode",
            "covers_execution_key_inventory_credits_and_catalog_queries",
            "controller_stage_launch_and_supervisor_lifecycle_blocked",
            "remote_inference_blocked_by_controller_flock",
            "remote_quiescence_receipts_required",
            "execution_usage_quiescence_requires_bound_remote_receipts"
          ]
        }
      },
      "required": [
        "schema_version", "method", "endpoint", "default_workspace_required",
        "default_workspace_unique_match_verified", "include_disabled", "page_size",
        "hard_page_limit", "pagination_termination", "repeated_page_detection",
        "page_count", "inventory_entry_count", "page_receipts", "match_fields",
        "float_match_tolerance", "execution_key_projection_sha256",
        "matched_inventory_projection_sha256", "unique_match_count",
        "match_digest_sha256", "provider_or_raw_key_hash_comparison_used",
        "inventory_rows_labels_or_provider_key_hashes_recorded", "critical_section"
      ]
    },
    "successful_non_402_canary_required": {
      "const": true
    },
    "models_available": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "openai/gpt-5.4",
          "anthropic/claude-opus-4.7",
          "deepseek/deepseek-v4-pro"
        ]
      }
    },
    "model_catalog": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "enum": [
              "openai/gpt-5.4",
              "anthropic/claude-opus-4.7",
              "deepseek/deepseek-v4-pro"
            ]
          },
          "context_length": {
            "type": "integer",
            "minimum": 1
          },
          "pricing": {
            "type": "object",
            "minProperties": 4,
            "propertyNames": {"pattern": "^[a-z0-9_]{1,64}$"},
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "required": ["prompt", "completion", "request", "internal_reasoning"]
          },
          "pricing_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "supported_parameters": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"}
          },
          "supported_parameters_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "request_semantics_support": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {"const": "openai_compatible_protocol_base_field"},
              "messages": {"const": "openai_compatible_protocol_base_field"},
              "temperature": {
                "enum": [
                  "declared_by_openrouter_models_catalog",
                  "requires_successful_real_request_canary"
                ]
              },
              "top_p": {
                "enum": [
                  "declared_by_openrouter_models_catalog",
                  "requires_successful_real_request_canary"
                ]
              },
              "max_tokens": {
                "enum": [
                  "declared_by_openrouter_models_catalog",
                  "requires_successful_real_request_canary"
                ]
              },
              "seed": {
                "enum": [
                  "declared_by_openrouter_models_catalog",
                  "requires_successful_real_request_canary"
                ]
              },
              "tool_protocol": {"const": "prompt_serialized_by_agentdojo_0.1.35"},
              "native_tools": {"const": "request_field_absent"},
              "native_tool_choice": {"const": "request_field_absent"}
            },
            "required": [
              "model", "messages", "temperature", "top_p", "max_tokens", "seed",
              "tool_protocol", "native_tools", "native_tool_choice"
            ]
          },
          "request_semantics_support_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "model_id", "context_length", "pricing", "pricing_sha256",
          "supported_parameters", "supported_parameters_sha256",
          "request_semantics_support", "request_semantics_support_sha256"
        ]
      }
    },
    "model_catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "created_at",
    "probe_phase",
    "http_status",
    "secret_material_recorded",
    "response_body_recorded",
    "credential_fingerprint_algorithm",
    "credential_fingerprint_sha256",
    "management_audit_fingerprint_algorithm",
    "management_audit_fingerprint_sha256",
    "management_key_identity_sha256",
    "management_audit_status",
    "management_audit_waiver_reason",
    "round_plan",
    "runtime_policy_semantic_sha256",
    "runtime_infra_file_sha256",
    "provider_limit_mode",
    "key_limit_usd",
    "key_limit_remaining_usd",
    "key_usage_usd",
    "key_limit_remaining_floor_usd",
    "key_limit_remaining_floor_formula",
    "credit_floor_proof_status",
    "credit_floor_waiver_reason",
    "local_software_run_cost_cap_usd",
    "local_software_cost_cap_action",
    "budget_policy",
    "budget_policy_sha256",
    "key_is_free_tier",
    "key_is_management",
    "key_is_provisioning",
    "key_disabled",
    "key_disabled_field_present",
    "key_limit_reset_policy",
    "key_expires_at",
    "deprecated_rate_limit_used",
    "account_total_funding_independently_observable",
    "funding_semantics",
    "account_balance_endpoint",
    "account_total_credits_usd",
    "account_total_usage_usd",
    "account_remaining_usd",
    "account_remaining_floor_usd",
    "account_balance_verified",
    "management_key_is_management",
    "management_key_is_provisioning",
    "management_key_disabled",
    "management_key_local_probe_only",
    "management_key_deployed_to_vps",
    "same_account_inventory_proof",
    "successful_non_402_canary_required",
    "models_available",
    "model_catalog",
    "model_catalog_sha256"
  ]
}
