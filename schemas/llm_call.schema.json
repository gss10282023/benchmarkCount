{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/llm_call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "agent_id_or_role": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C",
        "contract_drafter",
        "judge_only"
      ],
      "type": "string"
    },
    "api_key_env": {
      "$ref": "#/$defs/nonempty_string"
    },
    "attempt_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "call_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "case_unit_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_draft_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "contract_template_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "contract_template_version": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cost_calculation_method": {
          "enum": [
            "provider_reported",
            "tokens_times_config_rate",
            "unavailable"
          ],
          "type": "string"
        },
        "currency": {
          "const": "USD"
        },
        "missing_cost_reason": {
          "enum": [
            "provider_cost_unavailable",
            "pricing_table_unavailable",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_source": {
          "enum": [
            "provider_response",
            "config_estimate",
            "unavailable"
          ],
          "type": "string"
        },
        "pricing_source_hash": {
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_table_id": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_table_version": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "total_cost_usd": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "pricing_source",
        "pricing_table_id",
        "pricing_table_version",
        "pricing_source_hash",
        "cost_calculation_method",
        "missing_cost_reason",
        "total_cost_usd"
      ],
      "type": "object"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "evidence_contract_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "forbidden_input_assertion_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "hidden_input_assertion_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "max_tokens": {
      "minimum": 1,
      "type": "integer"
    },
    "model": {
      "$ref": "#/$defs/nonempty_string"
    },
    "model_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "prompt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_hash_method": {
      "const": "sha256"
    },
    "prompt_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "provider": {
      "$ref": "#/$defs/nonempty_string"
    },
    "rate_limit_bucket": {
      "$ref": "#/$defs/nonempty_string"
    },
    "record_slot_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "redaction_status": {
      "const": "no_secret_logged"
    },
    "request_timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "response_metadata": {
      "type": "object"
    },
    "response_timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "retry_index": {
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "llm_call/v1"
    },
    "source_bundle_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "temperature": {
      "minimum": 0,
      "type": "number"
    },
    "timeout_seconds": {
      "minimum": 1,
      "type": "integer"
    },
    "token_usage": {
      "additionalProperties": false,
      "properties": {
        "cached_prompt_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "completion_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "prompt_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "reasoning_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "cached_prompt_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "type": "object"
    },
    "visible_input_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "call_id",
    "domain",
    "phase",
    "experiment_type",
    "priority",
    "agent_id_or_role",
    "provider",
    "model",
    "model_version",
    "api_key_env",
    "prompt_version",
    "prompt_hash",
    "prompt_hash_method",
    "temperature",
    "max_tokens",
    "timeout_seconds",
    "retry_index",
    "rate_limit_bucket",
    "request_timestamp",
    "response_timestamp",
    "response_metadata",
    "token_usage",
    "cost",
    "config_hash",
    "manifest_hash",
    "redaction_status"
  ],
  "title": "llm_call",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
