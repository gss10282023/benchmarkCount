{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "miniwob",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "toolsandbox",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/evidence_contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "canonical_hash": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_hash_source": {
      "$ref": "#/$defs/path"
    },
    "canonicalization_method": {
      "const": "json_canonical_sha256"
    },
    "case_unit_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "claim_scope": {
      "$ref": "#/$defs/claim_scope"
    },
    "claim_text": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_draft_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_drafting_llm_call_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "contract_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "contract_status": {
      "enum": [
        "draft",
        "reviewed",
        "locked",
        "superseded",
        "clarification"
      ],
      "type": "string"
    },
    "contract_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "fail_rule": {
      "$ref": "#/$defs/nonempty_string"
    },
    "locked_at": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "locked_by": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "main_result_eligible": {
      "type": "boolean"
    },
    "manifest_contract_lock_ref": {
      "$ref": "#/$defs/nonempty_string"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "minimality_rationale": {
      "$ref": "#/$defs/nonempty_string"
    },
    "native_sources": {
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "minItems": 1,
      "type": "array"
    },
    "required_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "artifact_name": {
            "$ref": "#/$defs/nonempty_string"
          },
          "artifact_source": {
            "$ref": "#/$defs/nonempty_string"
          },
          "artifact_type": {
            "enum": [
              "trace",
              "post_state",
              "database_snapshot",
              "api_log",
              "browser_artifact",
              "network_trace",
              "file",
              "message",
              "tool_log",
              "native_evaluator_input",
              "native_evaluator_output",
              "screenshot",
              "structured_output",
              "stdout",
              "stderr",
              "llm_call_log",
              "other"
            ],
            "type": "string"
          },
          "contract_requirement_id": {
            "$ref": "#/$defs/nonempty_string"
          },
          "native_aligned_source_support": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact_id",
          "artifact_name",
          "artifact_source",
          "artifact_type",
          "contract_requirement_id",
          "native_aligned_source_support"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "review_record_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "schema_version": {
      "const": "evidence_contract/v1"
    },
    "sensitivity_report_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source_support": {
      "type": "object"
    },
    "stronger_measurement_mapping": {
      "$ref": "#/$defs/mapping"
    },
    "success_rule": {
      "$ref": "#/$defs/nonempty_string"
    },
    "supersedes_contract_hash": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_contract_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_contract_version": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "taxonomy_version": {
      "$ref": "#/$defs/nonempty_string"
    },
    "unresolve_rule": {
      "$ref": "#/$defs/nonempty_string"
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "domain",
    "case_unit_id",
    "task_id",
    "contract_version",
    "contract_status",
    "contract_hash",
    "manifest_hash",
    "taxonomy_version",
    "claim_text",
    "native_sources",
    "required_artifacts",
    "success_rule",
    "fail_rule",
    "unresolve_rule",
    "claim_scope",
    "stronger_measurement_mapping",
    "minimality_rationale",
    "source_support",
    "main_result_eligible",
    "contract_drafting_llm_call_id",
    "contract_draft_id",
    "review_record_id",
    "canonicalization_method",
    "canonical_hash_source",
    "canonical_hash",
    "manifest_contract_lock_ref"
  ],
  "title": "evidence_contract",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
