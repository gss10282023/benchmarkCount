{
  "$defs": {
    "agent_id": {
      "enum": [
        "Agent A",
        "Agent B",
        "Agent C",
        "Agent D"
      ],
      "type": "string"
    },
    "agent_probe_rationale": {
      "additionalProperties": false,
      "properties": {
        "leaderboard_interpretation": {
          "const": false
        },
        "non_redundant_measurement_probe": {
          "type": "boolean"
        },
        "spans_scale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_source_openness": {
          "$ref": "#/$defs/nonempty_string"
        },
        "spans_tool_use_style": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "non_redundant_measurement_probe",
        "spans_source_openness",
        "spans_scale",
        "spans_tool_use_style",
        "leaderboard_interpretation"
      ],
      "type": "object"
    },
    "appendix_failure_class": {
      "enum": [
        "none",
        "infra_pre_run",
        "evaluator_failure",
        "evaluator_unstable",
        "evidence_unresolve"
      ],
      "type": "string"
    },
    "claim_scope": {
      "enum": [
        "native_aligned",
        "stronger_measurement"
      ],
      "type": "string"
    },
    "deterministic_selection": {
      "additionalProperties": false,
      "properties": {
        "audit_sample_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "bootstrap_resample_count": {
          "minimum": 1,
          "type": "integer"
        },
        "bootstrap_seed": {
          "minimum": 0,
          "type": "integer"
        },
        "case_selection_order_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_case_unit_set_hash": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_smoke_case_units": {
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "type": "array"
        },
        "hash_function": {
          "const": "sha256"
        },
        "hash_salt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "rerun_subset_selection_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "smoke_exclusion_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "hash_function",
        "hash_salt_hash",
        "eligible_case_unit_set_hash",
        "excluded_smoke_case_units",
        "smoke_exclusion_hash",
        "case_selection_order_hash",
        "bootstrap_seed",
        "bootstrap_resample_count",
        "audit_sample_seed",
        "rerun_subset_selection_rule"
      ],
      "type": "object"
    },
    "diagnostic_status": {
      "enum": [
        "not_applicable",
        "completed",
        "infra_excluded",
        "evaluator_failure",
        "evaluator_unstable"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "agentdojo",
        "appworld",
        "webarena_verified",
        "tau3_retail",
        "androidworld",
        "workarena",
        "osworld_verified",
        "judge_only",
        "maintenance_update",
        "matched_budget_controls"
      ],
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "SUCCESS",
        "FAIL",
        "UNRESOLVE",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_type": {
      "enum": [
        "main",
        "appendix",
        "diagnostic",
        "audit",
        "maintenance_update",
        "matched_budget_control"
      ],
      "type": "string"
    },
    "formal_phase": {
      "enum": [
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "enters_native_aligned_main_envelope": {
          "type": "boolean"
        },
        "mapping_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "mapping_type": {
          "enum": [
            "sidecar",
            "appendix",
            "manifest"
          ],
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_type",
        "mapping_id",
        "path",
        "sha256",
        "enters_native_aligned_main_envelope"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "native_decisive_support": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_artifact_mapping": {
          "type": "boolean"
        },
        "official_provenance": {
          "type": "boolean"
        },
        "verified_object_or_direct_artifact_read": {
          "type": "boolean"
        }
      },
      "required": [
        "locked_artifact_mapping",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "official_provenance",
        "verified_object_or_direct_artifact_read"
      ],
      "type": "object"
    },
    "nonempty_string": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "smoke",
        "dry_run",
        "preflight",
        "full",
        "rerun"
      ],
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^(sha256:)?[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "unresolve_level": {
      "enum": [
        "trace_level",
        "instrument_level",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unresolve_reason": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "R7",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$id": "evidence_system/schemas/aggregate_metrics.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Step 3 formal fail-closed schema for the evidence-envelope experiment system.",
  "properties": {
    "FAIL": {
      "minimum": 0,
      "type": "integer"
    },
    "N_completed_scored_records": {
      "minimum": 0,
      "type": "integer"
    },
    "SUCCESS": {
      "minimum": 0,
      "type": "integer"
    },
    "UNRESOLVE": {
      "minimum": 0,
      "type": "integer"
    },
    "claim_scope": {
      "$ref": "#/$defs/claim_scope"
    },
    "counted_only_score": {
      "maximum": 1,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "counted_only_score_undefined_reason": {
      "enum": [
        "no_counted_records",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "denominator_audit_ref": {
      "$ref": "#/$defs/path"
    },
    "denominator_audit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "domain_display_name": {
      "$ref": "#/$defs/nonempty_string"
    },
    "experiment_type": {
      "$ref": "#/$defs/experiment_type"
    },
    "freeze_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "group_key": {
      "$ref": "#/$defs/nonempty_string"
    },
    "lower": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "phase": {
      "$ref": "#/$defs/formal_phase"
    },
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "schema_version": {
      "const": "aggregate_metrics/v1"
    },
    "source_scored_record_ids": {
      "items": {
        "$ref": "#/$defs/nonempty_string"
      },
      "type": "array"
    },
    "source_scored_record_set_hash": {
      "$ref": "#/$defs/sha256"
    },
    "upper": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "width": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "domain_display_name",
    "group_key",
    "phase",
    "experiment_type",
    "priority",
    "claim_scope",
    "N_completed_scored_records",
    "SUCCESS",
    "FAIL",
    "UNRESOLVE",
    "coverage",
    "counted_only_score",
    "counted_only_score_undefined_reason",
    "lower",
    "upper",
    "width",
    "source_scored_record_ids",
    "source_scored_record_set_hash",
    "denominator_audit_ref",
    "denominator_audit_sha256",
    "freeze_manifest_hash"
  ],
  "title": "aggregate_metrics",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
