{
  "$id": "evidence_system/schemas/agentdojo_full_evidence_acceptance_index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentdojo_full_evidence_acceptance_index",
  "description": "Content-blind integrity acceptance for the complete AgentDojo staging evidence branch.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "path_lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "case_unit_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "record_slot_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "agent_id": {"type": "string", "enum": ["Agent A", "Agent B", "Agent C"]},
        "execution_lock_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_directory": {"$ref": "#/$defs/path"},
        "raw_run_path": {"$ref": "#/$defs/path"},
        "raw_run_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_manifest_path": {"$ref": "#/$defs/path"},
        "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "environment_path": {"$ref": "#/$defs/path"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "native_job_path": {"$ref": "#/$defs/path"},
        "native_job_sha256": {"$ref": "#/$defs/sha256"},
        "job_binding_sha256": {"$ref": "#/$defs/sha256"},
        "job_identity_sha256": {"$ref": "#/$defs/sha256"},
        "formal_completion_marker_path": {"$ref": "#/$defs/path"},
        "formal_completion_marker_sha256": {"$ref": "#/$defs/sha256"},
        "formal_completion_marker_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_count": {"type": "integer", "minimum": 1},
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "job_tree_sha256": {"$ref": "#/$defs/sha256"},
        "native_trajectory_file_count": {"const": 3},
        "metadata_status": {"const": "completed"}
      },
      "required": [
        "job_id", "case_unit_id", "task_id", "record_slot_id", "run_id",
        "attempt_id", "seed", "agent_id", "execution_lock_sha256",
        "execution_policy_sha256", "evidence_directory", "raw_run_path",
        "raw_run_sha256", "artifact_manifest_path", "artifact_manifest_sha256",
        "environment_path", "environment_sha256", "native_job_path",
        "native_job_sha256", "job_binding_sha256", "job_identity_sha256",
        "formal_completion_marker_path", "formal_completion_marker_sha256",
        "formal_completion_marker_semantic_sha256", "artifact_count", "artifact_set_sha256",
        "job_tree_sha256", "native_trajectory_file_count", "metadata_status"
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_full_evidence_acceptance_index/v1"},
    "index_id": {"const": "agentdojo_full_v1.2.2_direct_evidence_acceptance"},
    "status": {"const": "accepted"},
    "locked_at": {"type": "string", "minLength": 1},
    "result_namespace": {"const": "agentdojo_full_v1.2.2_direct_execution_staging"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_lock": {"$ref": "#/$defs/path_lock"},
        "checklist_freeze_lock": {"$ref": "#/$defs/path_lock"},
        "review_quiescence_receipt": {"$ref": "#/$defs/path_lock"},
        "sealed_retrieval_receipt": {"$ref": "#/$defs/path_lock"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "formal_execution_receipts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completion": {"$ref": "#/$defs/path_lock"},
            "anomaly": {"$ref": "#/$defs/path_lock"},
            "remote_completion_index": {"$ref": "#/$defs/path_lock"}
          },
          "required": ["completion", "anomaly", "remote_completion_index"]
        },
        "staging_evidence_root": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "file_count": {"type": "integer", "minimum": 1}
          },
          "required": ["path", "tree_sha256", "file_count"]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cases": {"const": 949},
            "agents_per_case": {"const": 3},
            "record_slots": {"const": 2847},
            "native_trajectories": {"const": 8541},
            "completed": {"const": 2847},
            "missing": {"const": 0},
            "duplicate": {"const": 0},
            "unexpected": {"const": 0},
            "unresolved": {"const": 0}
          },
          "required": ["cases", "agents_per_case", "record_slots", "native_trajectories", "completed", "missing", "duplicate", "unexpected", "unresolved"]
        },
        "case_identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_id_order_sha256": {"$ref": "#/$defs/sha256"},
            "case_id_set_sha256": {"$ref": "#/$defs/sha256"},
            "suite_case_counts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "banking": {"const": 144},
                "slack": {"const": 105},
                "travel": {"const": 140},
                "workspace": {"const": 560}
              },
              "required": ["banking", "slack", "travel", "workspace"]
            }
          },
          "required": ["case_id_order_sha256", "case_id_set_sha256", "suite_case_counts"]
        },
        "entry_order": {"const": "execution_lock_job_plan"},
        "entries_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {
          "type": "array",
          "minItems": 2847,
          "maxItems": 2847,
          "items": {"$ref": "#/$defs/entry"}
        },
        "blind_audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw_run_projection": {"const": "top_level_integrity_metadata_only"},
            "artifact_bytes": {"const": "hashed_not_deserialized"},
            "trajectory_contents_materialized": {"const": false},
            "native_labels_materialized": {"const": false},
            "native_labels_emitted": {"const": false}
          },
          "required": ["raw_run_projection", "artifact_bytes", "trajectory_contents_materialized", "native_labels_materialized", "native_labels_emitted"]
        }
      },
      "required": ["execution_lock", "checklist_freeze_lock", "review_quiescence_receipt", "sealed_retrieval_receipt", "execution_policy_sha256", "formal_execution_receipts", "staging_evidence_root", "counts", "case_identity", "entry_order", "entries_sha256", "entries", "blind_audit"]
    },
    "definition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "index_id", "status", "locked_at", "result_namespace", "definition", "definition_sha256"],
  "x-step": "Step 3 Schema / Provenance / Validator"
}
