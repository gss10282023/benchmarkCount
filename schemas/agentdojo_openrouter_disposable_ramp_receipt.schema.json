{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_system/schemas/agentdojo_openrouter_disposable_ramp_receipt.schema.json",
  "title": "agentdojo_openrouter_disposable_ramp_receipt",
  "description": "Fail-closed aggregate receipt for the finalized 4-to-32 disposable AgentDojo concurrency ramp.",
  "x-step": "Step 3 Schema / Provenance / Validator",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "request_parameter_proof": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "temperature_present": {"const": true},
        "top_p_present": {"const": true},
        "max_tokens_present": {"const": true},
        "seed_present": {"const": true},
        "native_tools_absent": {"const": true},
        "native_tool_choice_absent": {"const": true},
        "prompt_based_tool_protocol": {"const": true}
      },
      "required": [
        "temperature_present", "top_p_present", "max_tokens_present",
        "seed_present", "native_tools_absent", "native_tool_choice_absent",
        "prompt_based_tool_protocol"
      ]
    },
    "per_model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model_ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "returned_provider_model_identity_sha256s": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "request_count": {"type": "integer", "minimum": 60},
        "success_count": {"type": "integer", "minimum": 60},
        "successful_request_parameter_proof": {"$ref": "#/$defs/request_parameter_proof"},
        "safe_concurrency": {"enum": [4, 8, 16, 32]},
        "stage_observations": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "worker_concurrency": {"enum": [4, 8, 16, 32]},
              "effective_workers": {"enum": [4, 8, 16, 32]},
              "ran_at_locked_target": {"type": "boolean"},
              "max_rolling_rpm": {"type": "integer", "minimum": 1},
              "max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
              "max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
              "max_active_requests": {"type": "integer", "minimum": 1},
              "max_active_worker_processes": {"type": "integer", "minimum": 1},
              "recovered_429_503_fraction": {"type": "number", "minimum": 0, "maximum": 1},
              "max_consecutive_429_503": {"type": "integer", "minimum": 0},
              "max_retry_delay_seconds_per_chain": {"type": "number", "minimum": 0}
            },
            "required": [
              "worker_concurrency", "effective_workers", "ran_at_locked_target",
              "max_rolling_rpm", "max_rolling_admission_reservation_units_per_minute",
              "max_rolling_provider_actual_tokens_per_minute",
              "max_active_requests", "max_active_worker_processes",
              "recovered_429_503_fraction", "max_consecutive_429_503",
              "max_retry_delay_seconds_per_chain"
            ]
          }
        }
      },
      "required": [
        "model_ordinal", "model_config_sha256", "returned_provider_model_identity_sha256s",
        "request_count", "success_count", "successful_request_parameter_proof",
        "safe_concurrency", "stage_observations"
      ]
    },
    "mixed_model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "returned_provider_model_identity_sha256s": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "request_count": {"type": "integer", "minimum": 1},
        "success_count": {"type": "integer", "minimum": 1},
        "successful_request_parameter_proof": {"$ref": "#/$defs/request_parameter_proof"}
      },
      "required": ["model_config_sha256", "returned_provider_model_identity_sha256s", "request_count", "success_count", "successful_request_parameter_proof"]
    }
  },
  "properties": {
    "schema_version": {"const": "agentdojo_openrouter_disposable_ramp_receipt/v1"},
    "status": {"const": "passed"},
    "created_at": {"type": "string", "format": "date-time"},
    "stages": {
      "type": "array",
      "prefixItems": [{"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}],
      "items": false, "minItems": 4, "maxItems": 4
    },
    "stage_receipts": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "worker_concurrency": {"enum": [4, 8, 16, 32]}
          , "effective_workers": {"enum": [4, 8, 16, 32]}
          , "model_ordinal": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "required": ["path", "sha256", "worker_concurrency", "effective_workers", "model_ordinal"]
      }
    },
    "global_mixed_canary_receipt": {"$ref": "#/$defs/file_ref"},
    "validation_round_plan": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "definition_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256", "definition_sha256"]
    },
    "measurement_receipt": {"$ref": "#/$defs/file_ref"},
    "policy_finalization_receipt": {"$ref": "#/$defs/file_ref"},
    "global_mixed_canary_observed": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "worker_concurrency": {"const": 4},
        "max_rolling_rpm": {"type": "integer", "minimum": 1},
        "max_rolling_admission_reservation_units_per_minute": {"type": "integer", "minimum": 1},
        "max_rolling_provider_actual_tokens_per_minute": {"type": "integer", "minimum": 0},
        "max_active_requests": {"type": "integer", "minimum": 1},
        "per_model": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/mixed_model"}
        }
      },
      "required": [
        "worker_concurrency", "max_rolling_rpm",
        "max_rolling_admission_reservation_units_per_minute",
        "max_rolling_provider_actual_tokens_per_minute",
        "max_active_requests", "per_model"
      ]
    },
    "suite_canaries": {
      "type": "array",
      "prefixItems": [
        {"const": "banking"}, {"const": "slack"},
        {"const": "travel"}, {"const": "workspace"}
      ],
      "items": false, "minItems": 4, "maxItems": 4
    },
    "four_suite_canary_complete": {"const": true},
    "stage_workload_sha256s": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}
    },
    "unresolved_http_429_or_503": {"const": 0},
    "max_observed_recovered_429_503_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "max_observed_consecutive_429_503": {"type": "integer", "minimum": 0},
    "max_observed_retry_delay_seconds_per_chain": {"type": "number", "minimum": 0},
    "worker_failures": {"const": 0},
    "model_substage_count": {"const": 12},
    "runtime_policy_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_infra_file_sha256": {"$ref": "#/$defs/sha256"},
    "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "management_audit_fingerprint_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "management_audit_status": {"enum": ["waived_by_user", "performed"]},
    "runtime_code": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agentdojo_execution_runtime_snapshot/v1"},
        "files": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "files", "aggregate_sha256"]
    },
    "pre_ramp_credential_receipt": {"$ref": "#/$defs/file_ref"},
    "post_ramp_credential_receipt": {"$ref": "#/$defs/file_ref"},
    "blind_health_ledgers": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/file_ref"}},
    "resource_ledgers": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/file_ref"}},
    "per_model": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/per_model"}},
    "blind_only": {"const": true},
    "formal_results_written": {"const": false},
    "score_results_written": {"const": false}
  },
  "required": [
    "schema_version", "status", "created_at", "stages", "stage_receipts",
    "global_mixed_canary_receipt", "validation_round_plan",
    "measurement_receipt", "policy_finalization_receipt",
    "global_mixed_canary_observed",
    "suite_canaries", "four_suite_canary_complete", "stage_workload_sha256s",
    "unresolved_http_429_or_503", "max_observed_recovered_429_503_fraction",
    "max_observed_consecutive_429_503", "max_observed_retry_delay_seconds_per_chain",
    "worker_failures",
    "model_substage_count",
    "runtime_policy_semantic_sha256", "runtime_infra_file_sha256",
    "credential_fingerprint_sha256", "management_audit_fingerprint_sha256", "management_audit_status",
    "runtime_code",
    "pre_ramp_credential_receipt", "post_ramp_credential_receipt",
    "blind_health_ledgers", "resource_ledgers", "per_model", "blind_only",
    "formal_results_written", "score_results_written"
  ]
}
