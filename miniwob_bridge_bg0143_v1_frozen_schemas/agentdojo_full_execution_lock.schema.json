  "required": ["schema_version", "lock_id", "lock_status", "locked_at", "result_namespace", "definition", "definition_sha256"],
  "title": "agentdojo_full_execution_lock",
  "type": "object",
  "x-step": "Step 3 Schema / Provenance / Validator"
}
