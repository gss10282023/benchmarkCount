{
  "$id": "evidence_system/schemas/agentdojo_full_execution_lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable pre-run definition for AgentDojo v1.2.2 full raw-evidence collection.",
  "$defs": {
    "nonempty_string": {"minLength": 1, "type": "string"},
    "path": {"minLength": 1, "type": "string"},
    "sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "path_lock": {
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    },
    "job_entry": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {"enum": ["Agent A", "Agent B", "Agent C"], "type": "string"},
        "attempt_id": {"$ref": "#/$defs/nonempty_string"},
        "case_unit_id": {"$ref": "#/$defs/nonempty_string"},
