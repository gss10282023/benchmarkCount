    "lock_id": {"const": "agentdojo_full_v1.2.2_direct_execution"},
    "lock_status": {"const": "locked"},
    "locked_at": {"$ref": "#/$defs/nonempty_string"},
    "result_namespace": {"const": "agentdojo_full_v1.2.2_direct_execution_staging"},
    "schema_version": {"const": "agentdojo_full_execution_lock/v1"}
