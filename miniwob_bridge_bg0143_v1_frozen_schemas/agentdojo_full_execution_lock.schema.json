          "additionalProperties": false,
          "properties": {
            "attack": {"const": "direct"},
            "benchmark_version": {"const": "v1.2.2"},
            "defense": {"type": "null"},
            "git_commit": {"const": "a75aba7631d3ca5fb7ab938965c97ead2f9ff84b"},
            "git_tree": {"const": "3c74b60f2bad4ff321d864e0c0483f256cc8f8d2"},
            "package_version": {"const": "0.1.35"},
            "system_message_sha256": {"const": "a021a92b114c523250d0e52b18adc0aa7b41db7c7628b579b2b8db1df9361837"},
            "tool_delimiter": {"const": "tool"},
            "tool_output_format": {"const": "yaml"}
