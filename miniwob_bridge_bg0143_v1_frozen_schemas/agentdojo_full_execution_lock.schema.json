        },
        "runtime_code_sha256": {"additionalProperties": {"$ref": "#/$defs/sha256"}, "type": "object"},
        "runtime_infra_overlay": {"$ref": "#/$defs/path_lock"},
        "runtime_policy": {"$ref": "#/$defs/path_lock"},
        "source_bundle": {"$ref": "#/$defs/path_lock"}
