        "record_slot_id": {"$ref": "#/$defs/nonempty_string"},
        "run_id": {"$ref": "#/$defs/nonempty_string"},
        "seed": {"minimum": 0, "type": "integer"},
        "task_id": {"$ref": "#/$defs/nonempty_string"}
