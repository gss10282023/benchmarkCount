{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_id",
    "component_type",
    "native",
    "stronger",
    "review_summary"
  ],
  "properties": {
    "component_id": {"type": "string", "minLength": 1},
    "component_type": {"type": "string", "enum": ["user", "injection"]},
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "success_if",
        "fail_if",
        "undecided_if",
        "decisive_artifacts",
        "source_pointers"
      ],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "success_if": {"type": "string", "minLength": 1},
        "fail_if": {"type": "string", "minLength": 1},
        "undecided_if": {"type": "string", "minLength": 1},
        "decisive_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "native/trace_logs/**.json",
              "native/proxy_calls/*.json",
              "logs/{sealed_worker.stdout.log,sealed_worker.stderr.log}",
              "adapter/{artifact_manifest,environment}.json"
            ]
          }
        },
        "source_pointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(official/(case_definition|evaluator_oracle_excerpts|state_schema_excerpts)\\.json|derived/stronger_measurement_basis\\.json)::.+$"
          }
        }
      }
    },
    "stronger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_conditions", "candidate_dispositions"],
      "properties": {
        "canonical_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "rationale", "decisive_artifacts", "source_pointers"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "text": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "decisive_artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "native/trace_logs/**.json",
                    "native/proxy_calls/*.json",
                    "logs/{sealed_worker.stdout.log,sealed_worker.stderr.log}",
                    "adapter/{artifact_manifest,environment}.json"
                  ]
                }
              },
              "source_pointers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(official/(case_definition|evaluator_oracle_excerpts|state_schema_excerpts)\\.json|derived/stronger_measurement_basis\\.json)::.+$"
                }
              }
            }
          }
        },
        "candidate_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "disposition", "reason"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "disposition": {"type": "string", "enum": ["keep", "merge", "remove"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "review_summary": {"type": "string", "minLength": 1}
  }
}
