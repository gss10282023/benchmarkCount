{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_unit_id", "case_analysis", "records"],
  "properties": {
    "case_unit_id": {"type": "string", "minLength": 1},
    "case_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apparent_benchmark_claim",
        "actual_checked_outcome",
        "record_binding_and_aggregation",
        "source_pointers"
      ],
      "properties": {
        "apparent_benchmark_claim": {"type": "string", "minLength": 1},
        "actual_checked_outcome": {"type": "string", "minLength": 1},
        "record_binding_and_aggregation": {"type": "string", "minLength": 1},
        "source_pointers": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_dir_name",
          "agent_id",
          "released_evaluator_label",
          "audit_status",
          "confirmed_benchmark_conflict",
          "different_outcome_description",
          "reason",
          "semantic_comparison",
          "source_pointers",
          "non_dispositive_checks"
        ],
        "properties": {
          "run_dir_name": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "enum": ["Agent A", "Agent B", "Agent C"]},
          "released_evaluator_label": {"type": "string", "enum": ["success", "fail"]},
          "audit_status": {
            "type": "string",
            "enum": ["confirmed_conflict", "not_confirmed", "insufficient"]
          },
          "confirmed_benchmark_conflict": {
            "type": ["boolean", "null"]
          },
          "different_outcome_description": {
            "type": ["string", "null"]
          },
          "reason": {"type": "string", "minLength": 1},
          "semantic_comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apparent_claim",
              "actual_checker",
              "aggregation",
              "record_binding",
              "relation"
            ],
            "properties": {
              "apparent_claim": {"type": "string", "minLength": 1},
              "actual_checker": {"type": "string", "minLength": 1},
              "aggregation": {"type": "string", "minLength": 1},
              "record_binding": {"type": "string", "minLength": 1}
              ,"relation": {
                "type": "string",
                "enum": [
                  "same_exact",
                  "same_outcome_weaker_or_under_specified",
                  "different_outcome",
                  "indeterminate"
                ]
              }
            }
          },
          "source_pointers": {
            "type": "array",
            "minItems": 7,
            "items": {"type": "string", "minLength": 1}
          },
          "non_dispositive_checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label_agreement_used_as_proof",
              "label_disagreement_used_as_proof",
              "stronger_result_used_as_proof"
            ],
            "properties": {
              "label_agreement_used_as_proof": {"type": "boolean", "const": false},
              "label_disagreement_used_as_proof": {"type": "boolean", "const": false},
              "stronger_result_used_as_proof": {"type": "boolean", "const": false}
            }
          }
        }
      }
    }
  }
}
